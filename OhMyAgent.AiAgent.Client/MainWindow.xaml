<Window x:Class="OhMyAgent.AiAgent.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        xmlns:views="clr-namespace:OhMyAgent.AiAgent.Client.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AgentSessionViewModel, IsDesignTimeCreatable=False}"
        Title="OhMyAgent — AI Agent Client"
        Height="700" Width="1000"
        MinHeight="500" MinWidth="700"
        Background="{StaticResource WindowBg}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Opacity="{Binding WindowOpacity}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/TranscriptTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 커스텀 타이틀바 드래그 영역 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 메뉴바 -->
            <RowDefinition Height="40"/>   <!-- 타이틀바 -->
            <RowDefinition Height="56"/>   <!-- 상태/도메인 바 -->
            <RowDefinition Height="*"/>    <!-- 채팅 영역 -->
            <RowDefinition Height="Auto"/> <!-- 입력 바 -->
        </Grid.RowDefinitions>

        <!-- ── 메뉴바 ─────────────────────────────────────────────── -->
        <Menu Grid.Row="0"
              Background="{StaticResource SurfaceBg}"
              Foreground="{StaticResource TextPrimary}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="6,2"
              FontSize="12">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{StaticResource Surface2Bg}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="MenuSeparator" TargetType="Separator">
                    <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="Height" Value="1"/>
                    <Setter Property="Margin" Value="4,4"/>
                </Style>
            </Menu.Resources>

            <MenuItem Header="파일(_F)">
                <MenuItem Header="단축키 설정(_S)..."
                          Click="MenuItem_HotkeySettings_Click"
                          InputGestureText="Ctrl+,"/>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="종료(_X)"
                          Click="MenuItem_Exit_Click"
                          InputGestureText="Alt+F4"/>
            </MenuItem>
        </Menu>

        <!-- ── 커스텀 타이틀바 ────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBg}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="7"
                            Background="{StaticResource AccentGradient}"
                            Margin="0,0,9,0">
                        <TextBlock Text="✦" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OhMyAgent"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0">
                    <!-- 투명도 슬라이더 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="투명도"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Slider Minimum="0.3" Maximum="1.0"
                                Value="{Binding WindowOpacity, Mode=TwoWay}"
                                Width="90" Height="20"
                                VerticalAlignment="Center"
                                SmallChange="0.05" LargeChange="0.1"
                                ToolTip="창 투명도 조절"/>
                    </StackPanel>
                    <Button Content="—"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource CaptionButton}"
                            Width="34" Height="28"
                            FontSize="16"
                            VerticalContentAlignment="Bottom"
                            Padding="0,0,0,4"
                            ToolTip="최소화"/>
                    <Button Content="🔽"
                            Click="TrayButton_Click"
                            Style="{StaticResource CaptionButton}"
                            Width="34" Height="28"
                            FontSize="13"
                            Margin="2,0,0,0"
                            ToolTip="트레이로 숨기기"/>
                    <Button Content="✕"
                            Click="CloseButton_Click"
                            Width="34" Height="28"
                            FontSize="12"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand"
                            Margin="2,0,0,0"
                            ToolTip="종료">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#FB7185"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 상태 / 권한 바 ─────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <!-- 연결 상태 + 작업 디렉토리 + 사용량 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrush}}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <!-- 작업 디렉토리 -->
                    <TextBlock Text=" | 📁 "
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WorkspaceRoot}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               MaxWidth="300"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding WorkspaceRoot}"/>
                    <!-- 토큰 사용량 -->
                    <TextBlock Text="{Binding LastUsageText}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="{Binding LastUsageText, Converter={StaticResource StringToVisibility}}"/>
                </StackPanel>

                <!-- 권한 모드 + 초기화 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="권한"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding PermissionModes}"
                              SelectedItem="{Binding CurrentPermissionMode, Mode=TwoWay}"
                              MinWidth="110"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <!-- 전체 초기화 -->
                    <Button Content="🗑 초기화"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="10,5"
                            FontSize="12"
                            Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 트랜스크립트 영역 ─────────────────────────────────── -->
        <Grid Grid.Row="3">

            <!-- 에이전트 트랜스크립트 -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          Background="{StaticResource WindowBg}"
                          Padding="0,8"
                          Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl x:Name="MessageList"
                              ItemsSource="{Binding Transcript}"
                              ItemTemplateSelector="{StaticResource TranscriptSelector}"
                              Focusable="False"/>
            </ScrollViewer>

            <!-- 인라인 승인 카드 (PendingApproval) -->
            <Border VerticalAlignment="Bottom"
                    Background="{StaticResource WindowBg}"
                    Visibility="{Binding PendingApproval, Converter={StaticResource NullToVisibility}}">
                <ContentControl Content="{Binding PendingApproval}"
                                ContentTemplate="{StaticResource ApprovalCardTemplate}"/>
            </Border>

            <!-- 오류 패널 -->
            <Grid Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                  Background="{StaticResource WindowBg}">
                <Border Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource ErrorDot}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="40,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="480">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠️"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="서버 연결 실패"
                                   Foreground="{StaticResource ErrorDot}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,24"
                                   LineHeight="20"/>
                        <Button Content="🔄  다시 시도"
                                Command="{Binding RetryConnectionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ── 입력 바 ──────────────────────────────────────────── -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
          <StackPanel>
            <!-- 진행 표시 -->
            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         Margin="0,0,0,8"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Style="{StaticResource DarkTextBox}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         MaxLines="4"
                         MinHeight="44"
                         MaxHeight="100"
                         VerticalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                         KeyDown="InputBox_KeyDown">
                    <TextBox.Resources>
                        <!-- Placeholder 텍스트 -->
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="메시지를 입력하세요... (Enter 전송, Shift+Enter 줄바꿈)"
                                                               Foreground="#5B6273"
                                                               FontSize="14"
                                                               Margin="14,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="메시지를 입력하세요... (Enter 전송, Shift+Enter 줄바꿈)"
                                                               Foreground="#5B6273"
                                                               FontSize="14"
                                                               Margin="14,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Grid.Column="1"
                        Content="전송"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="80"
                        Height="44"
                        Margin="10,0,0,0"
                        FontSize="14"/>

                <Button Grid.Column="2"
                        Content="중지"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource OutlineButton}"
                        Width="64"
                        Height="44"
                        Margin="8,0,0,0"
                        FontSize="14"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
          </StackPanel>
        </Border>

    </Grid>
</Window>
