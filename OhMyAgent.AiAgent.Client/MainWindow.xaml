<Window x:Class="OhMyAgent.AiAgent.Client.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        xmlns:views="clr-namespace:OhMyAgent.AiAgent.Client.Views"
        xmlns:models="clr-namespace:OhMyAgent.AiAgent.Client.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AgentSessionViewModel, IsDesignTimeCreatable=False}"
        Title="OhMyAgent — AI 에이전트"
        Height="720" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource WindowBg}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Opacity="{Binding WindowOpacity}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/TranscriptTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 권한 모드 드롭다운: 영문 enum을 한국어 라벨로 표시 -->
            <DataTemplate x:Key="PermissionModeItemTemplate">
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="수동 승인"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Static models:PermissionMode.AutoSafe}">
                                    <Setter Property="Text" Value="안전 작업 자동"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="{x:Static models:PermissionMode.FullAuto}">
                                    <Setter Property="Text" Value="전체 자동"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- 전체 UI 배율(접근성): 루트 LayoutTransform 으로 폰트·아이콘·여백 균일 확대 -->
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <!-- 사이드바: 접힘 시 폭 0 (BoolToGridLength, 펼침 폭 260) -->
            <ColumnDefinition Width="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToGridLength}, ConverterParameter=260}"/>
            <ColumnDefinition Width="*"/>    <!-- 메인 영역 -->
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             좌측 사이드바 (near-black)
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 상단 네비 -->
                    <RowDefinition Height="*"/>    <!-- 스크롤 목록 -->
                    <RowDefinition Height="Auto"/> <!-- 설정 -->
                </Grid.RowDefinitions>

                <!-- 상단 네비 아이콘 항목 -->
                <StackPanel Grid.Row="0">
                    <!-- 새 채팅 → ClearCommand -->
                    <Button Style="{StaticResource SidebarItemButton}"
                            Command="{Binding ClearCommand}"
                            ToolTip="새 채팅 (트랜스크립트 초기화)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource FontSizeSubtitle}" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="새 채팅" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 프로젝트 / 채팅 목록 -->
                <ScrollViewer Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 프로젝트 섹션 = 대화 세션 묶음 (미분류 포함). 작업 디렉토리는 설정에서 관리. -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="프로젝트" Style="{StaticResource SidebarSectionHeader}"
                                       Margin="0" VerticalAlignment="Center"/>
                            <!-- 새 프로젝트 -->
                            <Button Grid.Column="1" Style="{StaticResource ComposerIconButton}"
                                    Width="24" Height="24" FontSize="{StaticResource FontSizeBody}"
                                    Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Click="NewProject_Click"
                                    ToolTip="새 프로젝트"/>
                        </Grid>

                        <!-- 프로젝트 그룹 목록 (Projects.Projects) -->
                        <ItemsControl ItemsSource="{Binding Projects.Projects}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProjectItemViewModel}">
                                    <Expander IsExpanded="True" Margin="0,1,0,1"
                                              Background="Transparent" BorderThickness="0"
                                              Foreground="{StaticResource TextSecondary}"
                                              AllowDrop="True"
                                              DragOver="Project_DragOver" Drop="Project_Drop">
                                        <!-- 그룹 헤더: 프로젝트명 + 대화 수 + 동기화 배지 + 컨텍스트 메뉴 -->
                                        <Expander.Header>
                                            <Grid HorizontalAlignment="Stretch" Width="180">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE8B7;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="{StaticResource FontSizeBody}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- 동기화 배지 -->
                                                <TextBlock Grid.Column="2" Text="&#xE753;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="{StaticResource AccentSoftBrush}"
                                                           FontSize="{StaticResource FontSizeXSmall}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           ToolTip="서버 동기화됨"
                                                           Visibility="{Binding Synced, Converter={StaticResource BoolToVisibility}}"/>
                                                <!-- 대화 수 -->
                                                <TextBlock Grid.Column="3" Text="{Binding ConversationCount}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="{StaticResource FontSizeXSmall}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <!-- 실제 프로젝트만 컨텍스트 메뉴(rename/delete/sync) -->
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="이름 변경" Click="RenameProject_Click"
                                                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="서버 동기화" Click="SyncProject_Click"
                                                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="삭제" Click="DeleteProject_Click"
                                                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <!-- 미분류 그룹은 컨텍스트 메뉴 비활성 -->
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnassigned}" Value="True">
                                                                <Setter Property="ContextMenu" Value="{x:Null}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            </Grid>
                                        </Expander.Header>

                                        <!-- 그룹 자식: 대화 목록 -->
                                        <ItemsControl ItemsSource="{Binding Conversations}" Margin="14,2,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ChatSessionSummary}">
                                                    <!-- Tag: 아래 ContextMenu 가 프로젝트 목록에 닿기 위한 통로.
                                                         ContextMenu 는 별도 PopupRoot 에 있어 비주얼 트리로 Window 조상을 찾지 못하므로
                                                         (AncestorType=Window 은 항상 null → 메뉴가 빈 채로 뜬다) 트리 안에 있는 이 Grid 가
                                                         대신 목록을 받아 PlacementTarget.Tag 로 건넨다. -->
                                                    <Grid Background="Transparent"
                                                          Tag="{Binding DataContext.Projects.Projects, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          PreviewMouseLeftButtonDown="Conversation_PreviewMouseLeftButtonDown"
                                                          PreviewMouseMove="Conversation_PreviewMouseMove"
                                                          ToolTip="끌어서 프로젝트 폴더로 이동할 수 있습니다.">
                                                        <Button Style="{StaticResource SidebarItemButton}"
                                                                Command="{Binding DataContext.LoadChatSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Title}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="&#xE8BD;"
                                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                                           VerticalAlignment="Center" MaxWidth="130"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <Button Grid.Column="2" Style="{StaticResource ComposerIconButton}"
                                                                        Width="22" Height="22" FontSize="{StaticResource FontSizeXSmall}"
                                                                        Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                        Command="{Binding DataContext.DeleteChatSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="채팅 삭제"/>
                                                            </Grid>
                                                        </Button>
                                                        <!-- 대화 편입/해제: 프로젝트 목록을 동적으로 -->
                                                        <Grid.ContextMenu>
                                                            <ContextMenu ItemsSource="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                <ContextMenu.ItemContainerStyle>
                                                                    <!-- 각 MenuItem DataContext = ProjectItemViewModel (편입 대상).
                                                                         핸들러에서 Tag(대상 ProjectId)와 ContextMenu.PlacementTarget(대화)로 편입 수행. -->
                                                                    <Style TargetType="MenuItem">
                                                                        <Setter Property="Header" Value="{Binding Name}"/>
                                                                        <Setter Property="Tag" Value="{Binding Id}"/>
                                                                        <EventSetter Event="Click" Handler="AssignConversation_Click"/>
                                                                    </Style>
                                                                </ContextMenu.ItemContainerStyle>
                                                            </ContextMenu>
                                                        </Grid.ContextMenu>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 빈 상태: 프로젝트/대화 모두 없을 때 -->
                        <TextBlock Text="채팅 없음"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="{StaticResource FontSizeBody}" Margin="10,2,0,0"
                                   Visibility="{Binding Projects.Projects.Count, Converter={StaticResource EmptyCountToVisibility}}"/>

                        <!-- 동기화/상태 안내 -->
                        <TextBlock Text="{Binding Projects.StatusMessage}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="{StaticResource FontSizeXSmall}" Margin="10,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Projects.StatusMessage, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 하단 메신저 + 설정 -->
                <StackPanel Grid.Row="2">
                    <!-- 메신저 진입(안읽음 배지). 토글은 code-behind → App.ToggleMessenger(). -->
                    <Button Style="{StaticResource SidebarItemButton}" ToolTip="메신저"
                            Click="MenuItem_Messenger_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="{StaticResource FontSizeSubtitle}" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="메신저" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 안읽음 Pill 배지 (MainWindow code-behind 가 메신저 VM.TotalUnread 를 중계) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    CornerRadius="{StaticResource RadiusPill}" Background="{StaticResource AccentBrush}"
                                    MinWidth="18" Height="18" Padding="5,0"
                                    Visibility="{Binding MessengerUnread, ElementName=Root,
                                                 Converter={StaticResource UnreadCountToBadgeVisibility}}">
                                <TextBlock Text="{Binding MessengerUnread, ElementName=Root}" Foreground="White"
                                           FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource SidebarItemButton}"
                            Click="MenuItem_HotkeySettings_Click" ToolTip="설정">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource FontSizeSubtitle}" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="설정" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             우측 메인 영역
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{StaticResource WindowBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- 타이틀바 / 칩 / 캡션버튼 -->
                <RowDefinition Height="Auto"/> <!-- 업데이트 알림 배너 -->
                <RowDefinition Height="*"/>    <!-- 컨텐츠 -->
                <RowDefinition Height="Auto"/> <!-- 하단 컴포저/배너 -->
            </Grid.RowDefinitions>

            <!-- 상단 바: 모델/계정 칩 + 창 컨트롤 (드래그 가능) -->
            <Border Grid.Row="0" Background="{StaticResource WindowBg}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <!-- 상태 표시 (좌): 연결 상태 점 + 상태문 + 승인 대기 배지 + 토큰 사용량 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- 사이드바 접기/펼치기 토글 (접혀도 항상 보이는 위치) -->
                        <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource CaptionButton}"
                                Width="30" Height="28" Margin="0,0,8,0"
                                Content="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="{StaticResource FontSizeXSmall}" ToolTip="좌측 메뉴 접기/펼치기"/>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrush}}"
                                 ToolTip="{Binding StatusText}"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"
                                   FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>

                        <!-- 승인 대기 배지 (PendingApproval 존재 시) -->
                        <Border Style="{StaticResource Chip}" Margin="12,0,0,0"
                                Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                Visibility="{Binding PendingApproval, Converter={StaticResource NullToVisibility}}"
                                ToolTip="아래 카드에서 도구 실행을 승인하거나 거부하세요.">
                            <TextBlock Text="승인 대기" Foreground="{StaticResource WarningBrush}"
                                       FontSize="{StaticResource FontSizeXSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>

                        <!-- 토큰 사용량: 클릭 시 마지막 응답 ↔ 세션 누적 토큰 전환. Visibility 는 계속 LastUsageText 기준 -->
                        <Button Command="{Binding ToggleUsageViewCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                ToolTip="클릭하여 마지막 응답 ↔ 세션 누적 토큰 전환"
                                Visibility="{Binding LastUsageText, Converter={StaticResource StringToVisibility}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding UsageDisplayText}" Foreground="{StaticResource TextMuted}"
                                       FontSize="{StaticResource FontSizeXSmall}" VerticalAlignment="Center"/>
                        </Button>

                        <!-- ── 토큰 쿼터 칩 + 팝업 (HasQuota 일 때만) ── -->
                        <Grid Margin="12,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding HasQuota, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton x:Name="QuotaChip" Cursor="Hand"
                                          ToolTip="남은 사용량 — 클릭하여 일/주/월 상세 보기"
                                          Background="{StaticResource Surface2Bg}"
                                          BorderThickness="1">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="{StaticResource RadiusMd}"
                                                            Padding="8,3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="QIcon" Text="&#xE9D9;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="{StaticResource FontSizeXSmall}"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock x:Name="QText" Text="{Binding QuotaSummary}"
                                                                       FontSize="{StaticResource FontSizeXSmall}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding QuotaConstrained}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                            <Setter TargetName="QText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            <Setter TargetName="QIcon" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsChecked, ElementName=QuotaChip}"
                                   PlacementTarget="{Binding ElementName=QuotaChip}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                   HorizontalOffset="0" VerticalOffset="6">
                                <Border Background="{StaticResource Surface2Bg}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusLg}" Padding="14,12" MinWidth="260">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/> <!-- 칩 표시 기준 선택 -->
                                                <ColumnDefinition Width="Auto"/> <!-- 새로고침 -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="남은 사용량" FontWeight="SemiBold"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <!-- 상단 칩에 표시할 기준 (자동/일/주/월) -->
                                            <ComboBox Grid.Column="1" Margin="0,0,6,0"
                                                      ItemsSource="{Binding QuotaChipWindowOptions}"
                                                      SelectedItem="{Binding QuotaChipWindow, Mode=TwoWay}"
                                                      MinWidth="74" VerticalAlignment="Center"
                                                      ToolTip="상단 칩에 표시할 기준">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding}" Value="auto"><Setter Property="Text" Value="자동"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding}" Value="day"><Setter Property="Text" Value="일"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding}" Value="week"><Setter Property="Text" Value="주"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding}" Value="month"><Setter Property="Text" Value="월"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="2" Style="{StaticResource ComposerIconButton}"
                                                    Width="24" Height="24" FontSize="{StaticResource FontSizeBody}"
                                                    Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    Command="{Binding RefreshQuotaCommand}"
                                                    ToolTip="남은 사용량 새로고침"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding QuotaWindows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 라벨 (일/주/월) -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   FontSize="{StaticResource FontSizeXSmall}"
                                                                   Foreground="{StaticResource TextSecondary}"/>

                                                        <StackPanel Grid.Column="1">
                                                            <!-- 게이지 (비무제한) -->
                                                            <ProgressBar Height="6" Maximum="100"
                                                                         Value="{Binding PercentRemaining, Mode=OneWay}"
                                                                         Background="{StaticResource Surface3Bg}"
                                                                         BorderThickness="0"
                                                                         Visibility="{Binding IsUnlimited, Converter={StaticResource InverseBoolToVisibility}}">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsConstrained}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>

                                                            <!-- 무제한 표기 (막대 대신) -->
                                                            <TextBlock Text="&#x221E; 무제한" Margin="0,1,0,0"
                                                                       FontSize="{StaticResource FontSizeXSmall}"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       Visibility="{Binding IsUnlimited, Converter={StaticResource BoolToVisibility}}"/>

                                                            <Grid Margin="0,3,0,0"
                                                                  Visibility="{Binding IsUnlimited, Converter={StaticResource InverseBoolToVisibility}}">
                                                                <TextBlock Text="{Binding AmountText}" HorizontalAlignment="Left"
                                                                           FontSize="{StaticResource FontSizeXSmall}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsConstrained}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding PeriodText}" HorizontalAlignment="Right"
                                                                           FontSize="{StaticResource FontSizeMicro}"
                                                                           Foreground="{StaticResource TextMuted}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <!-- 캡션 버튼 (우) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 투명도 슬라이더 -->
                        <TextBlock Text="투명도" VerticalAlignment="Center" Margin="0,0,6,0"
                                   FontSize="{StaticResource FontSizeXSmall}" Foreground="{StaticResource TextMuted}"/>
                        <Slider Minimum="0.3" Maximum="1.0" Value="{Binding WindowOpacity, Mode=TwoWay}"
                                Width="80" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"
                                SmallChange="0.05" LargeChange="0.1" ToolTip="창 투명도"/>
                        <Button Content="&#xE921;" Click="MinimizeButton_Click"
                                Style="{StaticResource CaptionButton}" Width="34" Height="28"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeXSmall}" ToolTip="최소화"/>
                        <Button Content="&#xE944;" Click="TrayButton_Click"
                                Style="{StaticResource CaptionButton}" Width="34" Height="28"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeXSmall}"
                                Margin="2,0,0,0" ToolTip="트레이로 숨기기"/>
                        <Button Content="&#xE8BB;" Click="CloseButton_Click" Width="34" Height="28"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeXSmall}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextSecondary}" Cursor="Hand"
                                Margin="2,0,0,0" ToolTip="종료">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#FB7185"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 업데이트 알림 배너 (UpdateNotice 비어있지 않을 때만) ── -->
            <Border Grid.Row="1" Margin="16,0,16,0" Padding="14,8"
                    CornerRadius="{StaticResource RadiusMd}"
                    Visibility="{Binding UpdateNotice, Converter={StaticResource StringToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- 권장 업데이트: 액센트 소프트 -->
                        <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <!-- 필수 업데이트: 경고색 -->
                            <DataTrigger Binding="{Binding UpdateMandatory}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"
                               Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateMandatory}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding UpdateNotice}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- ── 컨텐츠: 환영(빈 트랜스크립트) ↔ 트랜스크립트 ── -->
            <Grid Grid.Row="2">

                <!-- 트랜스크립트 뷰 (항목 있을 때) -->
                <ScrollViewer x:Name="ChatScrollViewer" Padding="24,8"
                              Visibility="{Binding Transcript.Count, Converter={StaticResource CountToVisibility}}">
                    <!-- 트랜스크립트: 창 너비에 맞춰 늘어남(고정 캡 제거). 버블은 내부에서 너비의 82%로 비례. -->
                    <ItemsControl x:Name="MessageList"
                                  ItemsSource="{Binding Transcript}"
                                  ItemTemplateSelector="{StaticResource TranscriptSelector}"
                                  HorizontalAlignment="Stretch"
                                  Focusable="False"/>
                </ScrollViewer>

                <!-- 환영 화면 (빈 트랜스크립트) -->
                <ScrollViewer Visibility="{Binding Transcript.Count, Converter={StaticResource EmptyCountToVisibility}}"
                              VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Center" MaxWidth="720" Margin="24,0">
                        <StackPanel VerticalAlignment="Center" Margin="0,40,0,0">
                            <!-- 환영 헤딩 -->
                            <TextBlock Text="{Binding GreetingText}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <!-- 안내 부제: 현재 작업 공간 -->
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeBody}" Margin="0,0,0,4">
                                <Run Text="작업 공간"/>
                                <Run Text="{Binding WorkspaceRoot, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimary}"/>
                                <Run Text="에서 파일·셸·도구 작업을 자율로 수행합니다."/>
                            </TextBlock>
                            <TextBlock Text="아래 입력창에 하고 싶은 작업을 적어 보세요."
                                       TextAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,14"/>

                            <!-- 제안 항목 (Suggestions 바인딩, 비면 숨김) -->
                            <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,20,0,0"
                                          Visibility="{Binding Suggestions.Count, Converter={StaticResource CountToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SuggestionItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="{StaticResource FontSizeBodyLarge}" Width="26" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 오류 패널 -->
                <Grid Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                      Background="{StaticResource WindowBg}">
                    <Border Background="{StaticResource SurfaceBg}"
                            BorderBrush="{StaticResource ErrorDot}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius2Xl}" Padding="40,32"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource ErrorDot}"
                                       FontSize="{StaticResource FontSizeDisplay}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding ErrorTitle}" Foreground="{StaticResource ErrorDot}"
                                       FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,0,0,24" LineHeight="20"/>
                            <Button Content="{Binding PrimaryActionText}" Command="{Binding ConnectionActionCommand}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── 작업 계획 카드 (manage_todos) — 항목이 있을 때 트랜스크립트 상단에 오버레이 ── -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                        Margin="24,8,24,0" Padding="14,10"
                        Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Effect="{StaticResource SoftShadow}"
                        Visibility="{Binding HasTodos, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="작업 계획" Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource AppFont}" FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Todos}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock x:Name="Glyph" Text="○" Width="16"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       VerticalAlignment="Top" Margin="0,1,6,0"/>
                                            <TextBlock x:Name="Body" Text="{Binding Content}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="{StaticResource FontSizeSmall}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                <Setter TargetName="Glyph" Property="Text" Value="●"/>
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Body" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                <Setter TargetName="Body" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                <Setter TargetName="Glyph" Property="Text" Value="✓"/>
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource ConnectedDot}"/>
                                                <Setter TargetName="Body" Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Setter TargetName="Body" Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── 하단: 컴포저 + 워크스페이스 칩 + 인라인 승인 + 배너 ── -->
            <!-- 하단 컴포저: 창 너비에 맞춰 늘어남(고정 캡 제거). -->
            <StackPanel Grid.Row="3" Margin="24,0,24,18"
                        HorizontalAlignment="Stretch">

                <!-- 인라인 승인 카드 (PendingApproval) -->
                <Border Margin="0,0,0,12"
                        Visibility="{Binding PendingApproval, Converter={StaticResource NullToVisibility}}">
                    <ContentControl Content="{Binding PendingApproval}"
                                    ContentTemplate="{StaticResource ApprovalCardTemplate}"/>
                </Border>

                <!-- 진행 표시 -->
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 대형 라운드 컴포저 카드 -->
                <Border Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius3Xl}" Padding="16,12" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 첨부 칩 -->
                            <RowDefinition Height="Auto"/> <!-- 입력 -->
                            <RowDefinition Height="Auto"/> <!-- 툴바 -->
                        </Grid.RowDefinitions>

                        <!-- 첨부 칩 목록 (HasAttachments일 때만 표시) -->
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding Attachments}"
                                      Margin="0,0,0,8"
                                      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}"
                                            Background="{StaticResource Surface2Bg}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontSizeXSmall}"
                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextSecondary}"
                                                       FontSize="{StaticResource FontSizeXSmall}" VerticalAlignment="Center"
                                                       MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                            <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    Style="{StaticResource ComposerIconButton}"
                                                    Width="18" Height="18" FontSize="{StaticResource FontSizeMicro}" Margin="5,0,0,0"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="첨부 제거"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 멀티라인 입력 -->
                        <Grid Grid.Row="1">
                            <TextBox x:Name="InputBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontFamily="{StaticResource AppFont}" FontSize="{StaticResource FontSizeBodyLarge}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     SelectionBrush="{StaticResource AccentBrush}"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     MaxLines="6" MinHeight="40" MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                     PreviewKeyDown="InputBox_PreviewKeyDown"
                                     TextChanged="InputBox_TextChanged"
                                     SelectionChanged="InputBox_SelectionChanged"/>

                            <!-- @파일 자동완성 팝업 (입력창 위에 뜬다) -->
                            <Popup IsOpen="{Binding FileMention.IsActive, Mode=OneWay}"
                                   PlacementTarget="{Binding ElementName=InputBox}"
                                   Placement="Top"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="True">
                                <Border Background="{StaticResource SurfaceBg}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Padding="4"
                                        MaxWidth="520"
                                        Effect="{StaticResource CardShadow}">
                                    <ListBox x:Name="MentionList"
                                             ItemsSource="{Binding FileMention.Candidates}"
                                             SelectedIndex="{Binding FileMention.SelectedIndex, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             MaxHeight="220"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MouseLeftButtonUp="MentionList_MouseLeftButtonUp">
                                        <!-- 기본 ListBoxItem 은 선택 시 시스템 파란색 하이라이트라 다크 테마에서 튄다.
                                             선택 항목을 액센트 배경 + 좌측 바로 표시(리눅스 자동완성 느낌). -->
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Root" Background="Transparent"
                                                                    CornerRadius="{StaticResource RadiusMd}"
                                                                    BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Bg}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Bg}"/>
                                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="8,4">
                                                    <TextBlock Text="📄" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="{StaticResource FontSizeSmall}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <!-- Placeholder -->
                            <TextBlock Text="작업을 입력하세요 (Enter 전송 · Shift+Enter 줄바꿈)" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontSizeBodyLarge}"
                                       Margin="2,2,0,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InputText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding InputText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- 하단 툴바 -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- + 첨부 -->
                                <ColumnDefinition Width="Auto"/> <!-- 권한모드(승인요청) -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/> <!-- 모델 칩 -->
                                <ColumnDefinition Width="Auto"/> <!-- 전송/중지 -->
                            </Grid.ColumnDefinitions>

                            <!-- + 첨부 (파일 첨부) -->
                            <Button Grid.Column="0" Style="{StaticResource ComposerIconButton}"
                                    Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Click="AttachButton_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    ToolTip="첨부"/>

                            <!-- 권한 모드 선택 (수동 승인 / 안전 작업 자동 / 전체 자동) -->
                            <ComboBox Grid.Column="1" Margin="6,0,0,0" MinWidth="0"
                                      ItemsSource="{Binding PermissionModes}"
                                      SelectedItem="{Binding CurrentPermissionMode, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource PermissionModeItemTemplate}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                      ToolTip="도구 실행 권한 모드: 수동 승인 / 안전 작업 자동 / 전체 자동"/>

                            <!-- 권한 모드 힌트 (현재 모드 설명). Column 2 는 기존 * 스페이서 자리 — 좌측 정렬로 스페이서 역할 겸함 -->
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                       HorizontalAlignment="Left"
                                       FontSize="{StaticResource FontSizeXSmall}" Foreground="{StaticResource TextMuted}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="모든 도구 실행을 직접 승인"/>
                                        <Setter Property="ToolTip" Value="모든 도구 실행을 직접 승인"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPermissionMode}" Value="{x:Static models:PermissionMode.AutoSafe}">
                                                <Setter Property="Text" Value="읽기 등 안전 작업만 자동, 위험 작업은 승인"/>
                                                <Setter Property="ToolTip" Value="읽기 등 안전 작업만 자동, 위험 작업은 승인"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentPermissionMode}" Value="{x:Static models:PermissionMode.FullAuto}">
                                                <Setter Property="Text" Value="모든 도구 자동 실행(승인 없음)"/>
                                                <Setter Property="ToolTip" Value="모든 도구 자동 실행(승인 없음)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 모델 칩 — 설정에서 고른 모델을 표시 -->
                            <Border Grid.Column="3" Style="{StaticResource Chip}"
                                    Background="{StaticResource Surface2Bg}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,6,0"
                                    ToolTip="{Binding ModelTooltipText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="모델: " Foreground="{StaticResource TextSecondary}"
                                               FontSize="{StaticResource FontSizeXSmall}" VerticalAlignment="Center"/>
                                    <!-- 모델 ID 는 길 수 있어 잘라 표시하고, 전체는 툴팁으로. -->
                                    <TextBlock Text="{Binding ModelDisplayText}" Foreground="{StaticResource TextSecondary}"
                                               FontSize="{StaticResource FontSizeXSmall}" VerticalAlignment="Center"
                                               MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- 전송(원형) / 중지 토글 -->
                            <Grid Grid.Column="4" Margin="6,0,0,0">
                                <!-- 전송: 실행 중 아닐 때 -->
                                <Button Style="{StaticResource ComposerSendButton}"
                                        Command="{Binding SendCommand}"
                                        Content="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        ToolTip="전송"
                                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <!-- 중지(정사각): 실행 중일 때 -->
                                <Button Style="{StaticResource ComposerSendButton}"
                                        Command="{Binding StopCommand}"
                                        Content="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        ToolTip="중지"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 워크스페이스 칩 (My project ⌄ → WorkspaceRoot 표시, 클릭 시 설정 열기) -->
                <Button HorizontalAlignment="Left" Margin="2,10,0,0"
                        Style="{StaticResource ComposerChipButton}"
                        Click="MenuItem_HotkeySettings_Click"
                        ToolTip="작업 공간 변경 (설정)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="{StaticResource FontSizeBody}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WorkspaceRoot}" VerticalAlignment="Center"
                                   MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                        <!-- 활성 디렉토리 2개 이상이면 "외 N개" 표시 (잘리지 않게 경로 칩과 분리) -->
                        <TextBlock Text="{Binding ExtraWorkspacesText}" VerticalAlignment="Center"
                                   Margin="7,0,0,0" FontSize="{StaticResource FontSizeXSmall}" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentSoftBrush}"
                                   Visibility="{Binding ExtraWorkspacesText, Converter={StaticResource StringToVisibility}}"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="{StaticResource FontSizeCaption}" Margin="6,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
