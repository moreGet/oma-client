<Window x:Class="OhMyAgent.AiAgent.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        xmlns:views="clr-namespace:OhMyAgent.AiAgent.Client.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="OhMyAgent — AI Agent Client"
        Height="700" Width="1000"
        MinHeight="500" MinWidth="700"
        Background="{StaticResource WindowBg}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Opacity="{Binding WindowOpacity}">

    <Window.Resources>

        <!-- ── 메시지 DataTemplate: 사용자 ─────────────────────────── -->
        <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
            <Grid Margin="80,3,12,3">
                <Border Background="{StaticResource UserBubble}"
                        CornerRadius="14,14,2,14"
                        Padding="14,10"
                        HorizontalAlignment="Right"
                        MaxWidth="560">
                    <TextBlock Text="{Binding Content}"
                               Foreground="White"
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="22"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ── 메시지 DataTemplate: AI ─────────────────────────────── -->
        <DataTemplate x:Key="AgentMessageTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
            <Grid Margin="12,3,80,3">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="🤖  AI Agent"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               Margin="4,0,0,3"/>
                    <Border Background="{StaticResource AgentBubble}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2,14,14,14"
                            Padding="14,10"
                            MaxWidth="640">
                        <StackPanel>
                            <TextBlock Text="{Binding Content}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                            <!-- 스트리밍 커서 -->
                            <TextBlock Text="▋"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="14"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="1" To="0"
                                                            Duration="0:0:0.5"
                                                            AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ── Template Selector ────────────────────────────────────── -->
        <views:MessageTemplateSelector x:Key="MsgSelector"
            UserTemplate="{StaticResource UserMessageTemplate}"
            AgentTemplate="{StaticResource AgentMessageTemplate}"/>

    </Window.Resources>

    <!-- 커스텀 타이틀바 드래그 영역 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 메뉴바 -->
            <RowDefinition Height="40"/>   <!-- 타이틀바 -->
            <RowDefinition Height="56"/>   <!-- 상태/도메인 바 -->
            <RowDefinition Height="*"/>    <!-- 채팅 영역 -->
            <RowDefinition Height="Auto"/> <!-- 입력 바 -->
        </Grid.RowDefinitions>

        <!-- ── 메뉴바 ─────────────────────────────────────────────── -->
        <Menu Grid.Row="0"
              Background="{StaticResource SurfaceBg}"
              Foreground="{StaticResource TextPrimary}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="6,2"
              FontSize="12">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{StaticResource Surface2Bg}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="MenuSeparator" TargetType="Separator">
                    <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="Height" Value="1"/>
                    <Setter Property="Margin" Value="4,4"/>
                </Style>
            </Menu.Resources>

            <MenuItem Header="파일(_F)">
                <MenuItem Header="단축키 설정(_S)..."
                          Click="MenuItem_HotkeySettings_Click"
                          InputGestureText="Ctrl+,"/>
                <Separator Style="{StaticResource MenuSeparator}"/>
                <MenuItem Header="종료(_X)"
                          Click="MenuItem_Exit_Click"
                          InputGestureText="Alt+F4"/>
            </MenuItem>
        </Menu>

        <!-- ── 커스텀 타이틀바 ────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBg}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <TextBlock Text="OhMyAgent"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0">
                    <!-- 투명도 슬라이더 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="투명도"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <Slider Minimum="0.3" Maximum="1.0"
                                Value="{Binding WindowOpacity, Mode=TwoWay}"
                                Width="80" Height="20"
                                VerticalAlignment="Center"
                                SmallChange="0.05" LargeChange="0.1"
                                ToolTip="창 투명도 조절"/>
                    </StackPanel>
                    <Button Content="—"
                            Click="MinimizeButton_Click"
                            Width="36" Height="28"
                            FontSize="16"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand"
                            VerticalContentAlignment="Bottom"
                            Padding="0,0,0,4"
                            ToolTip="최소화"/>
                    <Button Content="🔽"
                            Click="TrayButton_Click"
                            Width="36" Height="28"
                            FontSize="13"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand"
                            ToolTip="트레이로 숨기기"/>
                    <Button Content="✕"
                            Click="CloseButton_Click"
                            Width="36" Height="28"
                            FontSize="12"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand"
                            ToolTip="종료">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F85149"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 상태 / 도메인 바 ───────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <!-- 연결 상태 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrush}}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <!-- MCP 상태 -->
                    <TextBlock Text=" | "
                               Foreground="{StaticResource TextMuted}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <Ellipse Width="6" Height="6"
                             Fill="{Binding IsMcpRunning, Converter={StaticResource BoolToStatusBrush}}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding McpStatusText}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 도메인 선택 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="도메인"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Domains}"
                              SelectedItem="{Binding SelectedDomain}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <!-- 채팅 초기화 -->
                    <Button Content="🗑 초기화"
                            Command="{Binding ClearMessagesCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="10,5"
                            FontSize="12"
                            Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 채팅 영역 ─────────────────────────────────────────── -->
        <Grid Grid.Row="3">

            <!-- 정상 채팅 목록 -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          Background="{StaticResource WindowBg}"
                          Padding="0,8"
                          Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl x:Name="MessageList"
                              ItemsSource="{Binding Messages}"
                              ItemTemplateSelector="{StaticResource MsgSelector}"
                              Focusable="False"/>
            </ScrollViewer>

            <!-- 오류 패널 -->
            <Grid Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                  Background="{StaticResource WindowBg}">
                <Border Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource ErrorDot}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="40,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="480">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠️"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="서버 연결 실패"
                                   Foreground="{StaticResource ErrorDot}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,24"
                                   LineHeight="20"/>
                        <Button Content="🔄  다시 시도"
                                Command="{Binding RetryConnectionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ── 입력 바 ──────────────────────────────────────────── -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Style="{StaticResource DarkTextBox}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         MaxLines="4"
                         MinHeight="44"
                         MaxHeight="100"
                         VerticalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                         KeyDown="InputBox_KeyDown">
                    <TextBox.Resources>
                        <!-- Placeholder 텍스트 -->
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="메시지를 입력하세요... (Enter 전송, Shift+Enter 줄바꿈)"
                                                               Foreground="#484F58"
                                                               FontSize="14"
                                                               Margin="12,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="메시지를 입력하세요... (Enter 전송, Shift+Enter 줄바꿈)"
                                                               Foreground="#484F58"
                                                               FontSize="14"
                                                               Margin="12,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Grid.Column="1"
                        Content="전송"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="80"
                        Height="44"
                        Margin="10,0,0,0"
                        FontSize="14"/>
            </Grid>
        </Border>

    </Grid>
</Window>
