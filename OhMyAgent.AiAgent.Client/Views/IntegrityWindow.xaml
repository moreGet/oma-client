<Window x:Class="OhMyAgent.AiAgent.Client.Views.IntegrityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        xmlns:models="clr-namespace:OhMyAgent.AiAgent.Client.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IntegrityViewModel, IsDesignTimeCreatable=False}"
        Title="무결성 검사 — OhMyAgent"
        Width="900" Height="680"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- 요약 카운트 칩 (라벨 + 색상 점 + 카운트) -->
        <Style x:Key="SummaryChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{StaticResource Surface2Bg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusTiny}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>          <!-- 타이틀바 -->
                <RowDefinition Height="Auto"/>        <!-- 대상/옵션 -->
                <RowDefinition Height="Auto"/>        <!-- 액션 바 -->
                <RowDefinition Height="Auto"/>        <!-- 진행률 -->
                <RowDefinition Height="Auto"/>        <!-- 요약 배지 -->
                <RowDefinition Height="*"/>           <!-- 결과 그리드 -->
                <RowDefinition Height="Auto"/>        <!-- 상태표시줄 -->
            </Grid.RowDefinitions>

            <!-- ── 타이틀바 ─────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBg}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusSm}"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,8,0">
                            <TextBlock Text="🛡" Foreground="White" FontSize="{StaticResource FontSizeXSmall}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="무결성 검사"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕"
                            Click="CloseButton_Click"
                            HorizontalAlignment="Right"
                            Width="30" Height="24"
                            FontSize="{StaticResource FontSizeXSmall}"
                            Foreground="{StaticResource TextSecondary}"
                            Style="{StaticResource CaptionButton}"/>
                </Grid>
            </Border>

            <!-- ── 대상/옵션 영역 ──────────────────────────────── -->
            <Border Grid.Row="1" Style="{StaticResource FloatingCard}" Margin="22,18,22,0">
                <StackPanel IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}">
                    <TextBlock Text="검사 대상 디렉토리"
                               Foreground="{StaticResource AccentSoftBrush}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}"
                                 Text="{Binding TargetDirectory, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontSize="{StaticResource FontSizeSmall}"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center"
                                 ToolTip="{Binding TargetDirectory}"/>
                        <Button Grid.Column="1"
                                Content="찾아보기..."
                                Click="BrowseTarget_Click"
                                Style="{StaticResource OutlineButton}"
                                Padding="14,6" FontSize="{StaticResource FontSizeSmall}" MinHeight="36"
                                Margin="8,0,0,0"/>
                        <Button Grid.Column="2"
                                Content="매니페스트 열기"
                                Click="OpenManifestLocation_Click"
                                Style="{StaticResource OutlineButton}"
                                Padding="14,6" FontSize="{StaticResource FontSizeSmall}" MinHeight="36"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding HasManifest}"
                                ToolTip="매니페스트가 저장된 폴더를 탐색기에서 엽니다."/>
                    </Grid>

                    <!-- 옵션 행 -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Content="하위 폴더 포함(재귀)"
                                  IsChecked="{Binding RecursiveOption, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="2"
                                  Content="서명 검사(Authenticode)"
                                  IsChecked="{Binding VerifySignaturesOption, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="확장자"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeXSmall}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding IncludeExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="200" MinHeight="32"
                                     FontSize="{StaticResource FontSizeSmall}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="콤마/세미콜론/공백 구분. 비우면 모든 파일. 예: exe,dll"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 액션 바 ─────────────────────────────────────── -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        Margin="22,16,22,0">
                <Button Content="검사 시작"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="22,9" FontSize="{StaticResource FontSizeBody}"
                        Margin="0,0,8,0"/>
                <Button Content="기준 매니페스트 생성"
                        Click="GenerateBaseline_Click"
                        Style="{StaticResource OutlineButton}"
                        Padding="18,9" FontSize="{StaticResource FontSizeBody}"
                        Margin="0,0,8,0"
                        ToolTip="현재 디렉토리 상태를 캡처해 기준 매니페스트를 만듭니다."/>
                <Button Content="취소"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineButton}"
                        Padding="18,9" FontSize="{StaticResource FontSizeBody}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- ── 진행률 ──────────────────────────────────────── -->
            <Border Grid.Row="3" Margin="22,14,22,0"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ProgressBar Height="6"
                                 Minimum="0" Maximum="1"
                                 Value="{Binding ProgressFraction, Mode=OneWay}"
                                 Background="{StaticResource Surface3Bg}"
                                 Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding ProgressText}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="{StaticResource FontSizeXSmall}"
                               Margin="2,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- ── 요약 배지 영역 ──────────────────────────────── -->
            <Grid Grid.Row="4" Margin="22,16,22,0"
                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 카운트 칩 5종 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource IntegrityOkBrush}" Margin="0,0,6,0"/>
                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center">
                                <Run Text="정상 "/><Run Text="{Binding OkCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource IntegrityModifiedBrush}" Margin="0,0,6,0"/>
                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center">
                                <Run Text="변조 "/><Run Text="{Binding ModifiedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource IntegrityCorruptedBrush}" Margin="0,0,6,0"/>
                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center">
                                <Run Text="손상 "/><Run Text="{Binding CorruptedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource IntegrityMissingBrush}" Margin="0,0,6,0"/>
                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center">
                                <Run Text="누락 "/><Run Text="{Binding MissingCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource IntegrityUnexpectedBrush}" Margin="0,0,6,0"/>
                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center">
                                <Run Text="추가 "/><Run Text="{Binding UnexpectedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 무결성 종합 배지 (양호/경고) -->
                <Border Grid.Column="1"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                            <Setter Property="Padding" Value="14,7"/>
                            <Setter Property="Background" Value="{StaticResource IntegrityCorruptedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIntact}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource IntegrityOkBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="White" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="⚠ 무결성 경고"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIntact}" Value="True">
                                        <Setter Property="Text" Value="✓ 무결성 양호"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- ── 결과 그리드 ─────────────────────────────────── -->
            <Border Grid.Row="5" Style="{StaticResource FloatingCard}" Margin="22,16,22,0"
                    Padding="2">
                <DataGrid ItemsSource="{Binding Files}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          Foreground="{StaticResource TextPrimary}"
                          FontFamily="{StaticResource AppFont}"
                          FontSize="{StaticResource FontSizeSmall}"
                          RowHeight="32"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <!-- 헤더 스타일 -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource Surface2Bg}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="FontSize" Value="{StaticResource FontSizeXSmall}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <!-- 셀 스타일 (포커스 사각형 제거) -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Surface2Bg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- 상태 (색상 점 + 한글 라벨) -->
                        <DataGridTemplateColumn Header="상태" Width="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileIntegrityItemViewModel}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource IntegrityMissingBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:IntegrityStatus.Ok}">
                                                            <Setter Property="Fill" Value="{StaticResource IntegrityOkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:IntegrityStatus.Modified}">
                                                            <Setter Property="Fill" Value="{StaticResource IntegrityModifiedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:IntegrityStatus.Corrupted}">
                                                            <Setter Property="Fill" Value="{StaticResource IntegrityCorruptedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:IntegrityStatus.Missing}">
                                                            <Setter Property="Fill" Value="{StaticResource IntegrityMissingBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:IntegrityStatus.Unexpected}">
                                                            <Setter Property="Fill" Value="{StaticResource IntegrityUnexpectedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="상대 경로"
                                            Binding="{Binding RelativePath}"
                                            Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding RelativePath}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="기대 해시"
                                            Binding="{Binding ExpectedSha256Short}"
                                            Width="Auto" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="실제 해시"
                                            Binding="{Binding ActualSha256Short}"
                                            Width="Auto" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="크기"
                                            Binding="{Binding SizeText}"
                                            Width="Auto" MinWidth="72">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="서명"
                                            Binding="{Binding SignatureText}"
                                            Width="Auto" MinWidth="72">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="비고"
                                            Binding="{Binding Detail}"
                                            Width="*" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ── 상태표시줄 ──────────────────────────────────── -->
            <Border Grid.Row="6"
                    Background="{StaticResource SurfaceBg}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,16,0,0"
                    Padding="22,8">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
