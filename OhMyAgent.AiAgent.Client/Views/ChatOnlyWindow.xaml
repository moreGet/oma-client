<Window x:Class="OhMyAgent.AiAgent.Client.Views.ChatOnlyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        xmlns:views="clr-namespace:OhMyAgent.AiAgent.Client.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="OhMyAgent Chat"
        Width="420" Height="560"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBg}"
        Opacity="{Binding WindowOpacity}">

    <Window.Resources>

        <!-- ── 메시지 DataTemplate: 사용자 ─────────────────────────── -->
        <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
            <Grid Margin="40,3,8,3">
                <Border Background="{StaticResource UserBubble}"
                        CornerRadius="14,14,2,14"
                        Padding="12,8"
                        HorizontalAlignment="Right"
                        MaxWidth="320">
                    <TextBlock Text="{Binding Content}"
                               Foreground="White"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ── 메시지 DataTemplate: AI ─────────────────────────────── -->
        <DataTemplate x:Key="AgentMessageTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
            <Grid Margin="8,3,40,3">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="🤖  AI Agent"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               Margin="4,0,0,3"/>
                    <Border Background="{StaticResource AgentBubble}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2,14,14,14"
                            Padding="12,8"
                            MaxWidth="340">
                        <StackPanel>
                            <TextBlock Text="{Binding Content}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>
                            <!-- 스트리밍 커서 -->
                            <TextBlock Text="▋"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="13"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="1" To="0"
                                                            Duration="0:0:0.5"
                                                            AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ── Template Selector ────────────────────────────────────── -->
        <views:MessageTemplateSelector x:Key="MsgSelector"
            UserTemplate="{StaticResource UserMessageTemplate}"
            AgentTemplate="{StaticResource AgentMessageTemplate}"/>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- 타이틀바 -->
            <RowDefinition Height="*"/>    <!-- 채팅 영역 -->
            <RowDefinition Height="Auto"/> <!-- 입력 바 -->
        </Grid.RowDefinitions>

        <!-- ── 커스텀 타이틀바 ────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBg}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0">
                <TextBlock Text="OhMyAgent Chat"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="✕"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Width="32" Height="24"
                        FontSize="11"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextSecondary}"
                        Cursor="Hand"
                        ToolTip="닫기 (Esc)">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F85149"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ── 채팅 영역 ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- 정상 채팅 목록 -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          Background="{StaticResource WindowBg}"
                          Padding="0,6"
                          Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Messages}"
                              ItemTemplateSelector="{StaticResource MsgSelector}"
                              Focusable="False"/>
            </ScrollViewer>

            <!-- 오류 패널 -->
            <Grid Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                  Background="{StaticResource WindowBg}">
                <Border Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource ErrorDot}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠️"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="서버 연결 실패"
                                   Foreground="{StaticResource ErrorDot}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16"
                                   LineHeight="18"/>
                        <Button Content="🔄  다시 시도"
                                Command="{Binding RetryConnectionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center"
                                Padding="14,6"
                                FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ── 입력 바 ──────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Style="{StaticResource DarkTextBox}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         MaxLines="3"
                         MinHeight="40"
                         MaxHeight="84"
                         FontSize="13"
                         VerticalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                         KeyDown="InputBox_KeyDown">
                    <TextBox.Resources>
                        <!-- Placeholder 텍스트 -->
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="메시지를 입력하세요..."
                                                               Foreground="#484F58"
                                                               FontSize="13"
                                                               Margin="12,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="메시지를 입력하세요..."
                                                               Foreground="#484F58"
                                                               FontSize="13"
                                                               Margin="12,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Grid.Column="1"
                        Content="전송"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="64"
                        Height="40"
                        Margin="8,0,0,0"
                        FontSize="13"
                        Padding="10,6"/>
            </Grid>
        </Border>

    </Grid>
</Window>
