<Window x:Class="OhMyAgent.AiAgent.Client.Views.ChatOnlyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        xmlns:views="clr-namespace:OhMyAgent.AiAgent.Client.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AgentSessionViewModel, IsDesignTimeCreatable=False}"
        Title="OhMyAgent Chat"
        Width="420" Height="560"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBg}"
        Opacity="{Binding WindowOpacity}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/TranscriptTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- 타이틀바 -->
            <RowDefinition Height="*"/>    <!-- 채팅 영역 -->
            <RowDefinition Height="Auto"/> <!-- 입력 바 -->
        </Grid.RowDefinitions>

        <!-- ── 커스텀 타이틀바 ────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBg}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="6"
                            Background="{StaticResource AccentGradient}"
                            Margin="0,0,7,0">
                        <TextBlock Text="✦" Foreground="White" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OhMyAgent Chat"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Width="30" Height="24"
                        FontSize="11"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextSecondary}"
                        Cursor="Hand"
                        ToolTip="닫기 (Esc)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#FB7185"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── 채팅 영역 ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- 에이전트 트랜스크립트 (컴팩트) -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          Background="{StaticResource WindowBg}"
                          Padding="0,6"
                          Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Transcript}"
                              ItemTemplateSelector="{StaticResource TranscriptSelector}"
                              Focusable="False"/>
            </ScrollViewer>

            <!-- 인라인 승인 카드 -->
            <Border VerticalAlignment="Bottom"
                    Background="{StaticResource WindowBg}"
                    Visibility="{Binding PendingApproval, Converter={StaticResource NullToVisibility}}">
                <ContentControl Content="{Binding PendingApproval}"
                                ContentTemplate="{StaticResource ApprovalCardTemplate}"/>
            </Border>

            <!-- 오류 패널 -->
            <Grid Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                  Background="{StaticResource WindowBg}">
                <Border Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource ErrorDot}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠️"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="서버 연결 실패"
                                   Foreground="{StaticResource ErrorDot}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16"
                                   LineHeight="18"/>
                        <Button Content="🔄  다시 시도"
                                Command="{Binding RetryConnectionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center"
                                Padding="14,6"
                                FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ── 입력 바 ──────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Style="{StaticResource DarkTextBox}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         MaxLines="3"
                         MinHeight="40"
                         MaxHeight="84"
                         FontSize="13"
                         VerticalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                         KeyDown="InputBox_KeyDown">
                    <TextBox.Resources>
                        <!-- Placeholder 텍스트 -->
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="메시지를 입력하세요..."
                                                               Foreground="#5B6273"
                                                               FontSize="13"
                                                               Margin="14,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="메시지를 입력하세요..."
                                                               Foreground="#5B6273"
                                                               FontSize="13"
                                                               Margin="14,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Grid.Column="1"
                        Content="전송"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="64"
                        Height="40"
                        Margin="8,0,0,0"
                        FontSize="13"
                        Padding="10,6"/>

                <Button Grid.Column="2"
                        Content="중지"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource OutlineButton}"
                        Width="52"
                        Height="40"
                        Margin="6,0,0,0"
                        FontSize="13"
                        Padding="8,6"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

    </Grid>
</Window>
