<Window x:Class="OhMyAgent.AiAgent.Client.Views.ChatOnlyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AgentSessionViewModel, IsDesignTimeCreatable=False}"
        Title="OhMyAgent Chat"
        Width="420" Height="560"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBg}"
        Opacity="{Binding WindowOpacity}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/TranscriptTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- 타이틀바 -->
            <RowDefinition Height="*"/>    <!-- 채팅 영역 -->
            <RowDefinition Height="Auto"/> <!-- 입력 바 -->
        </Grid.RowDefinitions>

        <!-- ── 커스텀 타이틀바 ────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBg}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="{StaticResource RadiusSm}"
                            Background="{StaticResource AccentGradient}"
                            Margin="0,0,7,0">
                        <TextBlock Text="✦" Foreground="White" FontSize="{StaticResource FontSizeCaption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OhMyAgent"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <!-- 연결 상태 점 + 상태문 -->
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrush}}"
                             ToolTip="{Binding StatusText}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="{StaticResource FontSizeXSmall}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Width="30" Height="24"
                        FontSize="{StaticResource FontSizeXSmall}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextSecondary}"
                        Cursor="Hand"
                        ToolTip="닫기 (Esc)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#FB7185"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── 채팅 영역 ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- 에이전트 트랜스크립트 (컴팩트) -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          Background="{StaticResource WindowBg}"
                          Padding="0,6"
                          Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Transcript}"
                              ItemTemplateSelector="{StaticResource TranscriptSelector}"
                              Focusable="False"/>
            </ScrollViewer>

            <!-- 인라인 승인 카드 -->
            <Border VerticalAlignment="Bottom"
                    Background="{StaticResource WindowBg}"
                    Visibility="{Binding PendingApproval, Converter={StaticResource NullToVisibility}}">
                <ContentControl Content="{Binding PendingApproval}"
                                ContentTemplate="{StaticResource ApprovalCardTemplate}"/>
            </Border>

            <!-- 오류 패널 -->
            <Grid Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                  Background="{StaticResource WindowBg}">
                <Border Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource ErrorDot}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}"
                        Padding="20,16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠️"
                                   FontSize="{StaticResource FontSizeHeadingLarge}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding ErrorTitle}"
                                   Foreground="{StaticResource ErrorDot}"
                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16"
                                   LineHeight="18"/>
                        <Button Content="{Binding PrimaryActionText}"
                                Command="{Binding ConnectionActionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center"
                                Padding="14,6"
                                FontSize="{StaticResource FontSizeSmall}"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ── 입력 바 (컴팩트 라운드 컴포저) ───────────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource WindowBg}" Padding="10,8,10,10">
            <StackPanel>
                <!-- 진행 표시 -->
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

                <Border Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius2Xl}" Padding="12,8" Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBox x:Name="InputBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontFamily="{StaticResource AppFont}" FontSize="{StaticResource FontSizeBody}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     SelectionBrush="{StaticResource AccentBrush}"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     MaxLines="4" MinHeight="24" MaxHeight="100"
                                     VerticalScrollBarVisibility="Auto"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                     KeyDown="InputBox_KeyDown"/>
                            <TextBlock Text="작업을 입력하세요 (Enter 전송)" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FontSizeBody}"
                                       Margin="2,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InputText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding InputText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- 전송(원형) / 중지 토글 -->
                        <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource ComposerSendButton}"
                                    Command="{Binding SendCommand}"
                                    Content="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    ToolTip="전송"
                                    Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <Button Style="{StaticResource ComposerSendButton}"
                                    Command="{Binding StopCommand}"
                                    Content="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    ToolTip="중지"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

    </Grid>
</Window>
