<UserControl x:Class="OhMyAgent.AiAgent.Client.Views.Chat.MentionFeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels.Chat"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MentionFeedViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="520" d:DesignHeight="560"
             Background="{StaticResource WindowBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="*"/>     <!-- 피드 -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE910;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="멘션"
                           Foreground="{StaticResource TextPrimary}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer Padding="14,10">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <Button Style="{StaticResource SidebarItemButton}"
                                    Command="{Binding DataContext.OpenMentionCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,4" HorizontalContentAlignment="Stretch">
                                <Border Style="{StaticResource FloatingCard}"
                                        Background="{StaticResource Surface2Bg}"
                                        Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Width="26" Height="26" CornerRadius="13"
                                                    Background="{StaticResource AccentSoftBrush}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding SenderName, Converter={StaticResource Initial}}"
                                                           Foreground="White"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding SenderName}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding SenderId}"/>
                                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource UnixSecondsToLocalTime}}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Content}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="60"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

            <TextBlock Text="멘션이 없습니다"
                       Foreground="{StaticResource TextMuted}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FontSizeSmall}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Items.Count, Converter={StaticResource EmptyCountToVisibility}}"/>
        </Grid>
    </Grid>
</UserControl>
