<Window x:Class="OhMyAgent.AiAgent.Client.Views.Chat.ChatMessengerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels.Chat"
        xmlns:chat="clr-namespace:OhMyAgent.AiAgent.Client.Views.Chat"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ChatMessengerViewModel, IsDesignTimeCreatable=False}"
        Title="OhMyAgent 메신저"
        Width="880" Height="620"
        MinWidth="640" MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="{StaticResource WindowBg}">

    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- 타이틀바 -->
                <RowDefinition Height="*"/>    <!-- 본문 2열 -->
            </Grid.RowDefinitions>

            <!-- ── 커스텀 타이틀바 (ChatOnlyWindow 미러) ─────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBg}"
                    CornerRadius="13,13,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="{StaticResource RadiusSm}"
                                Background="{StaticResource AccentGradient}" Margin="0,0,8,0">
                            <TextBlock Text="✦" Foreground="White" FontSize="{StaticResource FontSizeCaption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="메신저"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <!-- 연결 상태 점 -->
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding ConnectionState, Converter={StaticResource ChatConnectionStateToBrush}}"
                                 ToolTip="{Binding ConnectionState}"/>
                    </StackPanel>

                    <!-- 우측: 전역 안읽음 Pill + 멘션 토글 + 닫기 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource Chip}"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="{StaticResource RadiusPill}"
                                Margin="0,0,10,0"
                                Visibility="{Binding TotalUnread, Converter={StaticResource UnreadCountToBadgeVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="안읽음" Foreground="White"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="{StaticResource FontSizeMicro}" Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalUnread}" Foreground="White"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource CaptionButton}"
                                Width="30" Height="24"
                                Command="{Binding ToggleMentionFeedCommand}"
                                ToolTip="멘션 피드">
                            <TextBlock Text="&#xE910;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource FontSizeSmall}"/>
                        </Button>

                        <Button Content="✕" Click="CloseButton_Click"
                                Width="30" Height="24"
                                FontSize="{StaticResource FontSizeXSmall}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextSecondary}"
                                Cursor="Hand" ToolTip="닫기 (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                                            CornerRadius="{StaticResource RadiusMd}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#FB7185"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 본문: 좌 방목록 / 우 대화 또는 멘션피드 ─────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측 방 목록 -->
                <chat:ChatRoomsView Grid.Column="0" DataContext="{Binding Rooms}"/>

                <!-- 분할선 -->
                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"/>

                <!-- 우측: 멘션피드 토글 시 피드, 아니면 현재 방 -->
                <Grid Grid.Column="2">
                    <!-- 현재 방 -->
                    <ContentControl Content="{Binding CurrentRoom}"
                                    Visibility="{Binding IsMentionFeedOpen, Converter={StaticResource InverseBoolToVisibility}}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatRoomViewModel}">
                                <chat:ChatRoomView/>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <!-- 방 미선택 안내 (피드 닫힘 + CurrentRoom null) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CurrentRoom}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding IsMentionFeedOpen}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="✦" FontSize="{StaticResource FontSizeHeadingLarge}"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="대화를 선택하세요"
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 멘션 피드 -->
                    <chat:MentionFeedView DataContext="{Binding MentionFeed}"
                                          Visibility="{Binding DataContext.IsMentionFeedOpen,
                                                       RelativeSource={RelativeSource AncestorType=Window},
                                                       Converter={StaticResource BoolToVisibility}}"/>
                </Grid>

                <!-- 상태 메시지(403/404/429/5xx) 토스트 -->
                <Border Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Background="{StaticResource Surface2Bg}"
                        BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}"
                        Padding="14,8" Margin="0,12,0,0"
                        Effect="{StaticResource SoftShadow}"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeSmall}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
