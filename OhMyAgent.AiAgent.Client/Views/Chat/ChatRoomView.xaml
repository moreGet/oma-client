<UserControl x:Class="OhMyAgent.AiAgent.Client.Views.Chat.ChatRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels.Chat"
             xmlns:controls="clr-namespace:OhMyAgent.AiAgent.Client.Views.Chat.Controls"
             xmlns:local="clr-namespace:OhMyAgent.AiAgent.Client.Views.Chat"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatRoomViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="560" d:DesignHeight="620"
             Background="{StaticResource WindowBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="*"/>     <!-- 메시지 -->
            <RowDefinition Height="Auto"/>  <!-- 컴포저 -->
        </Grid.RowDefinitions>

        <!-- ── 헤더 ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource ConnectedDot}"
                                 VerticalAlignment="Center" Margin="0,0,5,0"
                                 Visibility="{Binding OnlinePresence.Count, Converter={StaticResource CountToVisibility}}"/>
                        <TextBlock Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeSmall}">
                            <Run Text="{Binding OnlinePresence.Count, Mode=OneWay}"/><Run Text="명 온라인"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 멤버관리 토글(Flyout) -->
                    <ToggleButton x:Name="MembersToggle" Style="{StaticResource ComposerIconButton}"
                                  ToolTip="멤버">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="{StaticResource FontSizeBodyLarge}"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 메시지 영역 ──────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessagesScroll"
                          Padding="0,8"
                          ScrollChanged="MessagesScroll_ScrollChanged"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>
                    <!-- 상단 더보기 로더 -->
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource AccentBrush}"
                                 Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVisibility}}"/>

                    <ItemsControl ItemsSource="{Binding Messages}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                                <controls:ChatMessageBubble/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 멤버 Flyout (헤더 토글) -->
            <Popup IsOpen="{Binding IsChecked, ElementName=MembersToggle}"
                   PlacementTarget="{Binding ElementName=MembersToggle}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <ContentControl Content="{Binding Members}" Width="260" Margin="0,6,8,0">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:RoomMembersViewModel}">
                            <local:RoomMembersView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Popup>

            <!-- typing 인디케이터 + 읽음 오버레이 -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="{StaticResource Surface2Bg}"
                    CornerRadius="{StaticResource RadiusPill}"
                    Padding="12,6" Margin="16,0,0,8"
                    Effect="{StaticResource SoftShadow}"
                    Visibility="{Binding TypingIndicatorText, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding TypingIndicatorText}"
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontStyle="Italic"/>
            </Border>
        </Grid>

        <!-- ── 컴포저 ───────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource WindowBg}" Padding="12,8,12,12">
            <StackPanel>
                <!-- 상태 메시지(403/404/429/5xx) -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource WarningBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Margin="4,0,0,6"
                           TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>

                <!-- 첨부 칩 목록 -->
                <ItemsControl ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,6"
                              Visibility="{Binding PendingAttachments.Count, Converter={StaticResource CountToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}"
                                    Background="{StaticResource Surface3Bg}"
                                    Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕" Margin="6,0,0,0"
                                            Style="{StaticResource CaptionButton}"
                                            Width="16" Height="16"
                                            FontSize="{StaticResource FontSizeMicro}"
                                            Command="{Binding DataContext.RemoveAttachmentCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 둥근 입력 카드 -->
                <Border Background="{StaticResource InputBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius2Xl}" Padding="8,6"
                        Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- 첨부 -->
                            <ColumnDefinition Width="*"/>     <!-- 입력 -->
                            <ColumnDefinition Width="Auto"/>  <!-- 전송 -->
                        </Grid.ColumnDefinitions>

                        <!-- 첨부(+) : 게이트 커맨드 + code-behind OpenFileDialog -->
                        <Button Grid.Column="0" Style="{StaticResource ComposerIconButton}"
                                VerticalAlignment="Bottom"
                                Click="AttachButton_Click"
                                Command="{Binding AttachFileCommand}"
                                ToolTip="첨부">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource FontSizeBodyLarge}"/>
                        </Button>

                        <!-- 멀티라인 입력 : Enter 전송 / Shift+Enter 줄바꿈(code-behind) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                            <TextBox x:Name="DraftBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontFamily="{StaticResource AppFont}" FontSize="{StaticResource FontSizeBody}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     SelectionBrush="{StaticResource AccentBrush}"
                                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     MaxLines="6" MinHeight="24" MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="DraftBox_PreviewKeyDown"/>
                            <TextBlock Text="메시지를 입력하세요 (Enter 전송, Shift+Enter 줄바꿈)"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource AppFont}" FontSize="{StaticResource FontSizeBody}"
                                       Margin="2,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Draft}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Draft}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- @멘션 자동완성 Popup -->
                            <controls:MentionAutoCompletePopup DataContext="{Binding Mentions}"
                                                               VerticalAlignment="Bottom"/>
                        </Grid>

                        <!-- 전송 -->
                        <Button Grid.Column="2" Style="{StaticResource ComposerSendButton}"
                                VerticalAlignment="Bottom"
                                Command="{Binding SendCommand}"
                                Content="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                ToolTip="전송 (Enter)"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
