<UserControl x:Class="OhMyAgent.AiAgent.Client.Views.Chat.ChatRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels.Chat"
             xmlns:controls="clr-namespace:OhMyAgent.AiAgent.Client.Views.Chat.Controls"
             xmlns:local="clr-namespace:OhMyAgent.AiAgent.Client.Views.Chat"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatRoomViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="560" d:DesignHeight="620"
             Background="{StaticResource WindowBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="*"/>     <!-- 메시지 -->
            <RowDefinition Height="Auto"/>  <!-- 컴포저 -->
        </Grid.RowDefinitions>

        <!-- ── 헤더 ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- 아바타 -->
                    <ColumnDefinition Width="*"/>     <!-- 이름 -->
                    <ColumnDefinition Width="Auto"/>  <!-- presence -->
                    <ColumnDefinition Width="Auto"/>  <!-- 멤버 토글 -->
                </Grid.ColumnDefinitions>

                <!-- 30x30 그라디언트 아바타 + 이니셜 -->
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                        Background="{StaticResource ChatAvatarGradient}"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource Initial}}"
                               Foreground="White" FontWeight="Bold"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                           Foreground="{StaticResource TextPrimary}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- presence: 발광 초록 점 + "N명 온라인" -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,8,0"
                            Visibility="{Binding OnlinePresence.Count, Converter={StaticResource CountToVisibility}}">
                    <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Ellipse Width="14" Height="14" Fill="{StaticResource ChatOnlineGlowBrush}"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource ChatOnlineBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Foreground="{StaticResource ChatMutedBrush}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeSmall}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding OnlinePresence.Count, Mode=OneWay}"/><Run Text="명 온라인"/>
                    </TextBlock>
                </StackPanel>

                <!-- 멤버관리 토글(Flyout) -->
                <ToggleButton Grid.Column="3" x:Name="MembersToggle"
                              Style="{StaticResource ComposerIconToggleButton}"
                              VerticalAlignment="Center" ToolTip="멤버">
                    <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="{StaticResource FontSizeBodyLarge}"/>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- ── 메시지 영역 ──────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <!-- 방 카드: 파랑 계열 서피스 + 라인 + 둥근 모서리 + 부드러운 그림자 -->
            <Border Background="{StaticResource ChatSurfaceBrush}"
                    BorderBrush="{StaticResource ChatLineBrush}" BorderThickness="1"
                    CornerRadius="18" Margin="12,8"
                    Effect="{StaticResource SoftShadow}">
                <Grid>
                    <!-- 메시지 리스트. 가상화 필수: 이력을 계속 올리면 수천 건이 쌓이는데
                         ScrollViewer>StackPanel 조합은 가상화가 꺼져 전량을 실체화한다(스크롤 렉의 원인).
                         ScrollViewer 를 ControlTemplate 안에 두어 VirtualizingStackPanel 이 스크롤 주인이 되게 한다. -->
                    <ItemsControl x:Name="MessagesList"
                                  ItemsSource="{Binding Messages}"
                                  Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLengthUnit="Page"
                                  VirtualizingPanel.CacheLength="1,1">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer x:Name="MessagesScroll"
                                              Padding="0,8"
                                              Focusable="False"
                                              CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              ScrollChanged="MessagesScroll_ScrollChanged">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                                <controls:ChatMessageBubble/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 상단 더보기 로더(스크롤되지 않도록 리스트 위에 겹친다) -->
                    <ProgressBar IsIndeterminate="True" Height="3"
                                 VerticalAlignment="Top"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource ChatAccentBrush}"
                                 Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- 멤버 Flyout (헤더 토글) -->
            <Popup IsOpen="{Binding IsChecked, ElementName=MembersToggle}"
                   PlacementTarget="{Binding ElementName=MembersToggle}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <ContentControl Content="{Binding Members}" Width="260" Margin="0,6,8,0">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:RoomMembersViewModel}">
                            <local:RoomMembersView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Popup>

            <!-- typing 인디케이터: 20px 그라디언트 아바타 + 텍스트 + 페이드 "···" -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="{StaticResource ChatSurface2Brush}"
                    BorderBrush="{StaticResource ChatLineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPill}"
                    Padding="8,5" Margin="24,0,0,18"
                    Effect="{StaticResource SoftShadow}"
                    Visibility="{Binding TypingIndicatorText, Converter={StaticResource StringToVisibility}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6"
                            Background="{StaticResource ChatAvatarGradient}"
                            Margin="0,0,7,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE125;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White" FontSize="{StaticResource FontSizeMicro}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding TypingIndicatorText}"
                               Foreground="{StaticResource ChatDimBrush}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeSmall}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="···" Margin="4,0,0,0"
                               Foreground="{StaticResource ChatAccent2Brush}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeBodyLarge}"
                               FontWeight="Bold"
                               VerticalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.25" To="1" Duration="0:0:0.6"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── 컴포저 ───────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource WindowBg}" Padding="12,8,12,12">
            <StackPanel>
                <!-- 상태 메시지(403/404/429/5xx) -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource WarningBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Margin="4,0,0,6"
                           TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>

                <!-- 첨부 칩 목록 -->
                <ItemsControl ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,6"
                              Visibility="{Binding PendingAttachments.Count, Converter={StaticResource CountToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}"
                                    Background="{StaticResource Surface3Bg}"
                                    Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕" Margin="6,0,0,0"
                                            Style="{StaticResource CaptionButton}"
                                            Width="16" Height="16"
                                            FontSize="{StaticResource FontSizeMicro}"
                                            Command="{Binding DataContext.RemoveAttachmentCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 둥근 입력 카드 -->
                <Border Background="{StaticResource InputBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius2Xl}" Padding="8,6"
                        Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- 첨부 -->
                            <ColumnDefinition Width="*"/>     <!-- 입력 -->
                            <ColumnDefinition Width="Auto"/>  <!-- 전송 -->
                        </Grid.ColumnDefinitions>

                        <!-- 첨부(+) : 게이트 커맨드 + code-behind OpenFileDialog -->
                        <Button Grid.Column="0" Style="{StaticResource ComposerIconButton}"
                                VerticalAlignment="Bottom"
                                Click="AttachButton_Click"
                                Command="{Binding AttachFileCommand}"
                                ToolTip="첨부">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource FontSizeBodyLarge}"/>
                        </Button>

                        <!-- 멀티라인 입력 : Enter 전송 / Shift+Enter 줄바꿈(code-behind) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                            <TextBox x:Name="DraftBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontFamily="{StaticResource AppFont}" FontSize="{StaticResource FontSizeBody}"
                                     CaretBrush="{StaticResource ChatAccentBrush}"
                                     SelectionBrush="{StaticResource ChatAccentBrush}"
                                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     MaxLines="6" MinHeight="24" MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="DraftBox_TextChanged"
                                     PreviewKeyDown="DraftBox_PreviewKeyDown"/>
                            <TextBlock Text="메시지를 입력하세요 (Enter 전송, Shift+Enter 줄바꿈)"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource AppFont}" FontSize="{StaticResource FontSizeBody}"
                                       Margin="2,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Draft}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Draft}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- @멘션 자동완성 Popup -->
                            <controls:MentionAutoCompletePopup DataContext="{Binding Mentions}"
                                                               VerticalAlignment="Bottom"/>
                        </Grid>

                        <!-- 전송 -->
                        <Button Grid.Column="2" Style="{StaticResource ComposerSendButton}"
                                VerticalAlignment="Bottom"
                                Command="{Binding SendCommand}"
                                Content="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                ToolTip="전송 (Enter)"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
