<UserControl x:Class="OhMyAgent.AiAgent.Client.Views.Chat.RoomMembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels.Chat"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RoomMembersViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="260" d:DesignHeight="420">

    <Border Background="{StaticResource Surface2Bg}"
            BorderBrush="{StaticResource BorderLight}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}"
            Padding="14"
            Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 헤더 -->
                <RowDefinition Height="*"/>     <!-- 멤버 리스트 -->
                <RowDefinition Height="Auto"/>  <!-- group 액션 -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="멤버"
                       Foreground="{StaticResource TextPrimary}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FontSizeBodyLarge}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Members}"
                     SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent"
                                            CornerRadius="{StaticResource RadiusMd}" Padding="6,6" Margin="0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface3Bg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RoomMemberViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <!-- presence dot: Online=green / Offline=회색 -->
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Presence}" Value="Online">
                                                <Setter Property="Fill" Value="{StaticResource ConnectedDot}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding MemberId}"/>
                            <TextBlock Text="(나)" Margin="6,0,0,0"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsMe, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- group 한정 액션. 1:1 이면 IsGroup=false → 숨김 -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0"
                        Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                <!-- 멤버 추가: AddMembersCommand 는 member UUID 리스트 인자가 필요하므로 code-behind 가 입력 모달을 띄운다. -->
                <Button Content="멤버 추가"
                        Click="AddMembers_Click"
                        Style="{StaticResource OutlineButton}"
                        Padding="12,7" FontSize="{StaticResource FontSizeSmall}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                <Button Content="강퇴"
                        Command="{Binding KickCommand}"
                        Style="{StaticResource OutlineButton}"
                        Padding="12,7" FontSize="{StaticResource FontSizeSmall}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                <Button Content="나가기"
                        Command="{Binding LeaveCommand}"
                        Style="{StaticResource OutlineButton}"
                        Padding="12,7" FontSize="{StaticResource FontSizeSmall}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
