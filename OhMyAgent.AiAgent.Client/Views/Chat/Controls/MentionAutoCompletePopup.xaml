<UserControl x:Class="OhMyAgent.AiAgent.Client.Views.Chat.Controls.MentionAutoCompletePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels.Chat"
             mc:Ignorable="d"
             x:Name="MentionRoot"
             d:DataContext="{d:DesignInstance Type=vm:MentionAutoCompleteViewModel, IsDesignTimeCreatable=False}">

    <!-- 컴포저 위에 띄우는 @멘션 자동완성. Placement=Top, PlacementTarget 은 부모에서 지정. -->
    <!-- IsOpen 은 반드시 TwoWay: StaysOpen=False 인 Popup 이 바깥 클릭으로 스스로 닫힐 때
         VM 의 IsActive 가 true 로 굳으면 이후 어떤 입력에도 다시 열리지 않는다. -->
    <Popup IsOpen="{Binding IsActive, Mode=TwoWay}"
           Placement="Top"
           PlacementTarget="{Binding ElementName=MentionRoot}"
           AllowsTransparency="True"
           StaysOpen="False"
           Focusable="False"
           PopupAnimation="Fade"
           MaxHeight="220">
        <Border Background="{StaticResource Surface2Bg}"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}"
                Margin="0,0,0,6"
                MinWidth="220"
                Effect="{StaticResource SoftShadow}">
            <ScrollViewer MaxHeight="200" Padding="4">
                <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <!-- ↑↓ 키보드 이동 하이라이트(IsSelected) -->
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Surface3Bg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="11"
                                            Background="{StaticResource AccentSoftBrush}"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="@" Foreground="White"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Popup>
</UserControl>
