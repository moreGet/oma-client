<Window x:Class="OhMyAgent.AiAgent.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OhMyAgent — 로그인"
        Width="440" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}">

    <!-- 라운드 카드 + 섀도 -->
    <Border CornerRadius="18" Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <!-- 상단 액센트 글로우 -->
            <Border CornerRadius="18,18,0,0" Height="180" VerticalAlignment="Top" Opacity="0.18">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.9" RadiusY="1.0">
                        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- 드래그/닫기 헤더 -->
            <Grid VerticalAlignment="Top" Height="44" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">

                <!-- 좌상단: 서버 연결 상태 + 새로고침 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource ConnectedDot}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServerStatusText}" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <Button Command="{Binding RefreshStatusCommand}" Content="&#xE72C;"
                            Style="{StaticResource ComposerIconButton}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                            Width="26" Height="26" Margin="6,0,0,0"
                            ToolTip="서버 상태 새로고침"/>
                </StackPanel>

                <Button Content="&#xE8BB;" Click="Close_Click"
                        Style="{StaticResource ComposerIconButton}"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="36" Height="36" Margin="0,6,6,0"
                        ToolTip="닫기 (종료)"/>
            </Grid>

            <!-- 본문 -->
            <StackPanel Margin="40,0,40,0" VerticalAlignment="Center">

                <!-- 로고 -->
                <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{StaticResource AccentGradient}" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="28" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <Grid Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 메인 스파클 -->
                        <Path Fill="White" Stretch="Uniform" Width="34" Height="34"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M12,1 C12.8,7.2 16.8,11.2 23,12 C16.8,12.8 12.8,16.8 12,23 C11.2,16.8 7.2,12.8 1,12 C7.2,11.2 11.2,7.2 12,1 Z"/>
                        <!-- 보조 스파클 -->
                        <Path Fill="White" Opacity="0.9" Stretch="Uniform" Width="13" Height="13"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                              Data="M12,1 C12.8,7.2 16.8,11.2 23,12 C16.8,12.8 12.8,16.8 12,23 C11.2,16.8 7.2,12.8 1,12 C7.2,11.2 11.2,7.2 12,1 Z"/>
                    </Grid>
                </Border>

                <TextBlock Text="OhMyAgent" Foreground="{StaticResource TextPrimary}"
                           FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="생각은 당신이, 실행은 에이전트가" Foreground="{StaticResource TextSecondary}"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,28"/>

                <!-- 아이디 -->
                <TextBlock Text="사용자 ID" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="2,0,0,5"/>
                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource DarkTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" MinHeight="42" Margin="0,0,0,16"
                         KeyDown="Field_KeyDown"/>

                <!-- 비밀번호 -->
                <TextBlock Text="비밀번호" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="2,0,0,5"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource DarkPasswordBox}"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             KeyDown="Field_KeyDown"
                             FontSize="14" MinHeight="42" Margin="0,0,0,10"/>

                <!-- 상태 -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="2,0,0,14"
                           TextWrapping="Wrap" MinHeight="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorDot}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 로그인 버튼 -->
                <Button Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="46" FontSize="15" FontWeight="SemiBold">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="로그인"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Text" Value="로그인 중..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
