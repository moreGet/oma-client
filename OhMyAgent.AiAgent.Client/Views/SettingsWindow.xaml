<Window x:Class="OhMyAgent.AiAgent.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        xmlns:models="clr-namespace:OhMyAgent.AiAgent.Client.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="설정 — OhMyAgent"
        Width="480" Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBg}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- 권한 모드 드롭다운: 영문 enum을 한국어 라벨로 표시 -->
        <DataTemplate x:Key="PermissionModeItemTemplate">
            <TextBlock VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="수동 승인"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:PermissionMode.AutoSafe}">
                                <Setter Property="Text" Value="안전 작업 자동"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:PermissionMode.FullAuto}">
                                <Setter Property="Text" Value="전체 자동"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── 타이틀바 ─────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBg}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,8,0">
                            <TextBlock Text="⚙" Foreground="White" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="설정"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕"
                            Click="CloseButton_Click"
                            HorizontalAlignment="Right"
                            Width="30" Height="24"
                            FontSize="11"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#FB7185"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ── 본문 ────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="22,18">

              <!-- ═══ 카드: 사용자 프로필 ══════════════════════════ -->
              <Border Style="{StaticResource FloatingCard}" Margin="0,0,0,16">
                <StackPanel>
                <TextBlock Text="사용자 프로필"
                           Foreground="{StaticResource AccentSoftBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <TextBlock Text="사용자 이름"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding UserDisplayName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         MinHeight="36"
                         Margin="0,0,0,4"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="환영 화면 인사말에 표시됩니다. 비워두면 Windows 사용자명이 사용됩니다."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <Button Content="프로필 저장"
                        Command="{Binding SaveUserProfileCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Padding="18,7"
                        FontSize="12"
                        Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <!-- ═══ 카드: 에이전트 ═══════════════════════════════ -->
              <Border Style="{StaticResource FloatingCard}" Margin="0,0,0,16">
                <StackPanel>
                <TextBlock Text="에이전트"
                           Foreground="{StaticResource AccentSoftBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <!-- ════ 작업 디렉토리 ════════════════════════════ -->
                <TextBlock Text="작업 디렉토리"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"
                             Text="{Binding WorkspaceRoot, Mode=OneWay}"
                             IsReadOnly="True"
                             FontSize="12"
                             MinHeight="36"
                             VerticalContentAlignment="Center"
                             ToolTip="{Binding WorkspaceRoot}"/>
                    <Button Grid.Column="1"
                            Content="찾아보기..."
                            Click="BrowseWorkspace_Click"
                            Style="{StaticResource OutlineButton}"
                            Padding="14,6"
                            FontSize="12"
                            MinHeight="36"
                            Margin="8,0,0,0"
                            ToolTip="에이전트가 파일·셸 작업을 수행할 폴더를 선택합니다."/>
                </Grid>
                <TextBlock Foreground="{StaticResource TextMuted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="에이전트의 모든 파일·셸 작업은 이 폴더 안에서만 이루어집니다."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WorkspaceRoot}" Value="">
                                    <Setter Property="Text" Value="⚠ 작업 디렉토리가 지정되지 않았습니다. 작업을 시작하려면 폴더를 먼저 선택하세요."/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WorkspaceRoot}" Value="{x:Null}">
                                    <Setter Property="Text" Value="⚠ 작업 디렉토리가 지정되지 않았습니다. 작업을 시작하려면 폴더를 먼저 선택하세요."/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ════ 권한 모드 ════════════════════════════════ -->
                <TextBlock Text="권한 모드"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding PermissionModes}"
                          SelectedItem="{Binding PermissionMode, Mode=TwoWay}"
                          ItemTemplate="{StaticResource PermissionModeItemTemplate}"
                          HorizontalAlignment="Left"
                          MinWidth="180"
                          ToolTip="수동 승인: 매 도구 실행 전 확인 · 안전 작업 자동: 읽기 등 안전 도구만 자동 · 전체 자동: 모든 도구 자동"/>
                <TextBlock Text="수동 승인은 도구 실행 전마다 확인을 요청합니다. 안전 작업 자동은 읽기 등 위험이 낮은 도구만 자동 실행합니다."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16"
                           Visibility="{Binding ShowFullAutoWarning, Converter={StaticResource InverseBoolToVisibility}}"/>
                <TextBlock Text="⚠ 전체 자동: 모든 도구가 자동 승인됩니다 (파일 삭제 등 파괴적 작업 포함). 신뢰할 수 있는 작업에만 사용하세요."
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16"
                           Visibility="{Binding ShowFullAutoWarning, Converter={StaticResource BoolToVisibility}}"/>

                <!-- ════ 실행 한도 ════════════════════════════════ -->
                <TextBlock Text="실행 한도"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="최대 반복 (1–100)"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding MaxIterations, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="최대 토큰"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
                </StackPanel>
              </Border>

              <!-- ═══ 카드: 서버 설정 ══════════════════════════════ -->
              <Border Style="{StaticResource FloatingCard}" Margin="0,0,0,16">
                <StackPanel>
                <TextBlock Text="서버 설정"
                           Foreground="{StaticResource AccentSoftBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <TextBlock Text="API 서버 주소"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         MinHeight="36"
                         Margin="0,0,0,4"
                         VerticalContentAlignment="Center"
                         ToolTip="사내 AI 에이전트 API 서버의 기본 주소 (예: http://10.0.0.10:8080)"/>
                <TextBlock Text="사내 폐쇄망 AI 에이전트 API 서버의 기본 주소입니다."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <!-- ════ 로그인 (JWT) ═════════════════════════════ -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="사용자 ID"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="비밀번호"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <PasswordBox x:Name="LoginPasswordBox"
                                     PasswordChanged="LoginPasswordBox_PasswordChanged"
                                     Style="{StaticResource DarkPasswordBox}"
                                     FontSize="13"
                                     MinHeight="36"/>
                    </StackPanel>
                </Grid>

                <!-- 로그인 상태 + 버튼 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoginStatus}" Value="로그인 중...">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ConnectedDot}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding LoginStatus}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <!-- 미로그인(빈 상태): 안내 문구 -->
                                        <DataTrigger Binding="{Binding LoginStatus}" Value="">
                                            <Setter Property="Text" Value="로그인 전 — 인증이 필요합니다."/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LoginStatus}" Value="{x:Null}">
                                            <Setter Property="Text" Value="로그인 전 — 인증이 필요합니다."/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LoginStatus}" Value="로그인 중...">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ConnectedDot}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding LoginCommand}"
                            Padding="18,7"
                            FontSize="12"
                            MinHeight="36"
                            Margin="8,0,0,0"
                            ToolTip="사용자 ID/비밀번호로 인증해 토큰을 발급받습니다.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Setter Property="Content" Value="로그인"/>
                                <Style.Triggers>
                                    <!-- 사용자 ID 비었으면 비활성 -->
                                    <DataTrigger Binding="{Binding Username}" Value="">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Username}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <!-- 로그인 진행 중이면 비활성 + 라벨 변경 -->
                                    <DataTrigger Binding="{Binding LoginStatus}" Value="로그인 중...">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Content" Value="로그인 중..."/>
                                    </DataTrigger>
                                    <!-- 이미 로그인됨이면 라벨을 다시 로그인으로 -->
                                    <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                        <Setter Property="Content" Value="다시 로그인"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 인증 토큰: 로그인 성공 시 자동 채워짐. 직접 붙여넣기도 가능. -->
                <TextBlock Text="인증 토큰 (로그인 시 자동 입력)"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <PasswordBox x:Name="AuthTokenBox"
                             PasswordChanged="AuthTokenBox_PasswordChanged"
                             Style="{StaticResource DarkPasswordBox}"
                             FontSize="13"
                             MinHeight="36"
                             Margin="0,0,0,10"
                             ToolTip="로그인하면 자동으로 채워집니다. 토큰을 직접 발급받은 경우 여기에 붙여넣을 수 있습니다."/>

                <TextBlock Text="모델 ID"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              IsEditable="True"
                              ItemsSource="{Binding AvailableModels}"
                              Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"
                              MinHeight="36"
                              VerticalContentAlignment="Center"
                              ToolTip="사용할 모델 ID. 목록에서 선택하거나 직접 입력할 수 있습니다."/>
                    <Button Grid.Column="1"
                            Content="목록 불러오기"
                            Command="{Binding LoadModelsCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="12,6"
                            FontSize="12"
                            MinHeight="36"
                            Margin="8,0,0,0"
                            ToolTip="서버에서 사용 가능한 모델 목록을 불러옵니다. (로그인 필요)"/>
                </Grid>

                <Button Content="서버 설정 저장"
                        Command="{Binding SaveServerConfigCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Padding="18,7"
                        FontSize="12"
                        Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <!-- ═══ 카드: 채팅 단축키 ════════════════════════════ -->
              <Border Style="{StaticResource FloatingCard}" Margin="0,0,0,4">
                <StackPanel>
                <TextBlock Text="채팅 단축키"
                           Foreground="{StaticResource AccentSoftBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <!-- 단축키 표시 + 캡처/취소 버튼 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding DisplayText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontSize="13"
                             MinHeight="36"
                             VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="변경"
                            Command="{Binding StartCaptureCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="14,6"
                            FontSize="12"
                            MinHeight="36"
                            Margin="8,0,0,0"/>

                    <Button Grid.Column="2"
                            Content="취소"
                            Command="{Binding CancelCaptureCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="14,6"
                            FontSize="12"
                            MinHeight="36"
                            Margin="6,0,0,0"
                            IsEnabled="{Binding IsCapturing}"/>
                </Grid>

                <!-- 안내 메시지 (캡처 중) -->
                <TextBlock Text="새 단축키를 입력하세요... (Esc: 취소)"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           Margin="0,0,0,4"
                           Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}"/>

                <!-- ValidationError -->
                <TextBlock Text="{Binding ValidationError}"
                           Foreground="{StaticResource ErrorDot}"
                           FontSize="11"
                           Margin="0,0,0,4"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ValidationError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 단축키 저장 버튼 -->
                <Button Content="단축키 저장"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Padding="22,8"
                        FontSize="13"/>
                </StackPanel>
              </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
