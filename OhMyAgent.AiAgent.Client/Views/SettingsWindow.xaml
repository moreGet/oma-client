<Window x:Class="OhMyAgent.AiAgent.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        xmlns:models="clr-namespace:OhMyAgent.AiAgent.Client.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="설정 — OhMyAgent"
        Width="480" Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBg}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- 권한 모드 드롭다운: 영문 enum을 한국어 라벨로 표시 -->
        <DataTemplate x:Key="PermissionModeItemTemplate">
            <TextBlock VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="수동 승인"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:PermissionMode.AutoSafe}">
                                <Setter Property="Text" Value="안전 작업 자동"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static models:PermissionMode.FullAuto}">
                                <Setter Property="Text" Value="전체 자동"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- 폴더 접근 허용/차단 토글 스위치 (CheckBox 기반, BCL/WPF only) -->
        <Style x:Key="SwitchToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="22" CornerRadius="{StaticResource RadiusPill}"
                                Background="{StaticResource Surface2Bg}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="{StaticResource RadiusMd}"
                                    HorizontalAlignment="Left" Margin="3,0,0,0"
                                    Background="{StaticResource TextMuted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusTiny}">
        <Grid>
            <!-- 전체 UI 배율(접근성) 즉시 미리보기: 루트 LayoutTransform -->
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── 타이틀바 ─────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBg}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusSm}"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,8,0">
                            <TextBlock Text="⚙" Foreground="White" FontSize="{StaticResource FontSizeXSmall}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="설정"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕"
                            Click="CloseButton_Click"
                            HorizontalAlignment="Right"
                            Width="30" Height="24"
                            FontSize="{StaticResource FontSizeXSmall}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#FB7185"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ── 본문 ────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="22,18">

              <!-- ═══ 카드: 사용자 프로필 (서버 조회, 읽기 전용) ══════════ -->
              <Border Style="{StaticResource FloatingCard}" Margin="0,0,0,16">
                <StackPanel>
                <TextBlock Text="사용자 프로필"
                           Foreground="{StaticResource AccentSoftBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 이름 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="이름"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding ProfileDisplayName}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProfileDisplayName}" Value="">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProfileDisplayName}" Value="{x:Null}">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 조직 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="조직"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding ProfileOrganization}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProfileOrganization}" Value="">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProfileOrganization}" Value="{x:Null}">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 이메일 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="이메일"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding ProfileEmail}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProfileEmail}" Value="">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProfileEmail}" Value="{x:Null}">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 로딩/실패 상태 안내 (ProfileStatus 비면 숨김) -->
                <TextBlock Text="{Binding ProfileStatus}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProfileStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProfileStatus}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProfileStatus}" Value="프로필을 불러오지 못했습니다">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </StackPanel>
              </Border>

              <!-- ═══ 카드: 에이전트 ═══════════════════════════════ -->
              <Border Style="{StaticResource FloatingCard}" Margin="0,0,0,16">
                <StackPanel>
                <TextBlock Text="에이전트"
                           Foreground="{StaticResource AccentSoftBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <!-- ════ 작업 디렉토리 (다중 루트, 최대 10) ════════════ -->
                <TextBlock Text="작업 디렉토리"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <!-- 다중 루트 목록 -->
                <ItemsControl ItemsSource="{Binding Workspaces}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WorkspaceFolderViewModel}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 접근 허용/차단 토글 스위치 -->
                                <CheckBox Grid.Column="0"
                                          Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          ToolTip="이 폴더에 대한 에이전트 접근 허용/차단"/>

                                <!-- 경로 (말줄임 + ToolTip) -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Path}"
                                           ToolTip="{Binding Path}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 삭제 (부모 SettingsViewModel.RemoveWorkspaceCommand) -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource ComposerIconButton}"
                                        Width="26" Height="26" FontSize="{StaticResource FontSizeSmall}"
                                        Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        Margin="6,0,0,0"
                                        Command="{Binding DataContext.RemoveWorkspaceCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="목록에서 제거"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 빈 목록 경고 -->
                <TextBlock Text="⚠ 작업 디렉토리가 지정되지 않았습니다. 작업을 시작하려면 폴더를 먼저 추가하세요."
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,6"
                           Visibility="{Binding HasNoWorkspaces, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 폴더 추가 + 안내 -->
                <Button Content="폴더 추가..."
                        Click="AddWorkspace_Click"
                        IsEnabled="{Binding CanAddWorkspace}"
                        Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Left"
                        Padding="14,6"
                        FontSize="{StaticResource FontSizeSmall}"
                        MinHeight="34"
                        Margin="0,2,0,0"
                        ToolTip="에이전트가 파일·셸 작업을 수행할 폴더를 추가합니다."/>
                <TextBlock Foreground="{StaticResource TextMuted}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="에이전트의 모든 파일·셸 작업은 허용된 폴더 안에서만 이루어집니다. 폴더별로 접근을 허용/차단할 수 있습니다 (최대 10개)."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanAddWorkspace}" Value="False">
                                    <Setter Property="Text" Value="작업 디렉토리는 최대 10개까지 추가할 수 있습니다. 추가하려면 기존 폴더를 제거하세요."/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ════ 권한 모드 ════════════════════════════════ -->
                <TextBlock Text="권한 모드"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding PermissionModes}"
                          SelectedItem="{Binding PermissionMode, Mode=TwoWay}"
                          ItemTemplate="{StaticResource PermissionModeItemTemplate}"
                          HorizontalAlignment="Left"
                          MinWidth="180"
                          ToolTip="수동 승인: 매 도구 실행 전 확인 · 안전 작업 자동: 읽기 등 안전 도구만 자동 · 전체 자동: 모든 도구 자동"/>
                <TextBlock Text="수동 승인은 도구 실행 전마다 확인을 요청합니다. 안전 작업 자동은 읽기 등 위험이 낮은 도구만 자동 실행합니다."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16"
                           Visibility="{Binding ShowFullAutoWarning, Converter={StaticResource InverseBoolToVisibility}}"/>
                <TextBlock Text="⚠ 전체 자동: 모든 도구가 자동 승인됩니다 (파일 삭제 등 파괴적 작업 포함). 신뢰할 수 있는 작업에만 사용하세요."
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16"
                           Visibility="{Binding ShowFullAutoWarning, Converter={StaticResource BoolToVisibility}}"/>

                <!-- ════ 실행 한도 ════════════════════════════════ -->
                <TextBlock Text="실행 한도"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="최대 반복 (1–100)"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="{StaticResource FontSizeXSmall}"
                               Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding MaxIterations, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="{StaticResource FontSizeBody}"
                             MinHeight="36"
                             HorizontalAlignment="Left"
                             MinWidth="160"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="최대 토큰은 서버가 제어합니다."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="{StaticResource FontSizeXSmall}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- ════ 글씨 크기 (접근성) ════════════════════════════ -->
                <TextBlock Text="글씨 크기 (접근성)"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="0.9" Maximum="1.6" Value="{Binding UiScale, Mode=TwoWay}"
                            SmallChange="0.05" LargeChange="0.1" TickFrequency="0.1"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding UiScale, StringFormat={}{0:P0}}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               VerticalAlignment="Center"
                               MinWidth="44" TextAlignment="Right"
                               Margin="10,0,0,0"/>
                </Grid>
                <TextBlock Text="전체 UI(글씨·아이콘·여백)를 균일하게 확대/축소합니다 (90%~160%)."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

              <!-- ═══ 카드: 서버 설정 ══════════════════════════════ -->
              <Border Style="{StaticResource FloatingCard}" Margin="0,0,0,16">
                <StackPanel>
                <TextBlock Text="서버 설정"
                           Foreground="{StaticResource AccentSoftBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <TextBlock Text="API 서버 주소"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="{StaticResource FontSizeBody}"
                         MinHeight="36"
                         Margin="0,0,0,4"
                         VerticalContentAlignment="Center"
                         ToolTip="사내 AI 에이전트 API 서버의 기본 주소 (예: http://10.0.0.10:8080)"/>
                <TextBlock Text="사내 폐쇄망 AI 에이전트 API 서버의 기본 주소입니다."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <!-- 로그인 상태 + 로그아웃 (로그인 자체는 시작 게이트에서 처리) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoginStatus}" Value="로그인 중...">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ConnectedDot}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding LoginStatus}"
                                   FontSize="{StaticResource FontSizeXSmall}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <!-- 미로그인(빈 상태): 안내 문구 -->
                                        <DataTrigger Binding="{Binding LoginStatus}" Value="">
                                            <Setter Property="Text" Value="로그인 화면에서 인증하세요."/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LoginStatus}" Value="{x:Null}">
                                            <Setter Property="Text" Value="로그인 화면에서 인증하세요."/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LoginStatus}" Value="로그인 중...">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ConnectedDot}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding LogoutCommand}"
                            Padding="14,7" FontSize="{StaticResource FontSizeSmall}" MinHeight="36"
                            Content="로그아웃"
                            Style="{StaticResource OutlineButton}"
                            ToolTip="저장된 토큰을 제거하고 로그아웃합니다."
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>

                <TextBlock Text="모델 ID"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              IsEditable="True"
                              ItemsSource="{Binding AvailableModels}"
                              Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"
                              MinHeight="36"
                              VerticalContentAlignment="Center"
                              ToolTip="사용할 모델 ID. 목록에서 선택하거나 직접 입력할 수 있습니다."/>
                    <Button Grid.Column="1"
                            Content="목록 불러오기"
                            Command="{Binding LoadModelsCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="12,6"
                            FontSize="{StaticResource FontSizeSmall}"
                            MinHeight="36"
                            Margin="8,0,0,0"
                            ToolTip="서버에서 사용 가능한 모델 목록을 불러옵니다. (로그인 필요)"/>
                </Grid>

                <Button Content="서버 설정 저장"
                        Command="{Binding SaveServerConfigCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Padding="18,7"
                        FontSize="{StaticResource FontSizeSmall}"
                        Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <!-- ═══ 카드: 채팅 단축키 ════════════════════════════ -->
              <Border Style="{StaticResource FloatingCard}" Margin="0,0,0,4">
                <StackPanel>
                <TextBlock Text="채팅 단축키"
                           Foreground="{StaticResource AccentSoftBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <!-- 단축키 표시 + 캡처/취소 버튼 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding DisplayText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontSize="{StaticResource FontSizeBody}"
                             MinHeight="36"
                             VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="변경"
                            Command="{Binding StartCaptureCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="14,6"
                            FontSize="{StaticResource FontSizeSmall}"
                            MinHeight="36"
                            Margin="8,0,0,0"/>

                    <Button Grid.Column="2"
                            Content="취소"
                            Command="{Binding CancelCaptureCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="14,6"
                            FontSize="{StaticResource FontSizeSmall}"
                            MinHeight="36"
                            Margin="6,0,0,0"
                            IsEnabled="{Binding IsCapturing}"/>
                </Grid>

                <!-- 안내 메시지 (캡처 중) -->
                <TextBlock Text="새 단축키를 입력하세요... (Esc: 취소)"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           Margin="0,0,0,4"
                           Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}"/>

                <!-- ValidationError -->
                <TextBlock Text="{Binding ValidationError}"
                           Foreground="{StaticResource ErrorDot}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           Margin="0,0,0,4"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ValidationError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 단축키 저장 버튼 -->
                <Button Content="단축키 저장"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Padding="22,8"
                        FontSize="{StaticResource FontSizeBody}"/>
                </StackPanel>
              </Border>

              <!-- 앱 버전 표시 (빌드 해시 포함) -->
              <TextBlock Text="{Binding AppVersionText}"
                         Foreground="{StaticResource TextMuted}"
                         FontSize="{StaticResource FontSizeXSmall}"
                         HorizontalAlignment="Right"
                         Margin="0,16,4,0"/>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
