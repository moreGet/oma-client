<Window x:Class="OhMyAgent.AiAgent.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="설정 — OhMyAgent"
        Width="420" Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBg}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── 타이틀바 ─────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBg}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <TextBlock Text="설정"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Click="CloseButton_Click"
                            HorizontalAlignment="Right"
                            Width="32" Height="24"
                            FontSize="11"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F85149"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ── 본문 ────────────────────────────────────────── -->
            <StackPanel Grid.Row="1" Margin="24">

                <!-- 헤더 -->
                <TextBlock Text="채팅 단축키"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <!-- 단축키 표시 + 캡처/취소 버튼 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding DisplayText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontSize="13"
                             MinHeight="36"
                             VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Background" Value="#1C2A3A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="변경"
                            Command="{Binding StartCaptureCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="14,6"
                            FontSize="12"
                            MinHeight="36"
                            Margin="8,0,0,0"/>

                    <Button Grid.Column="2"
                            Content="취소"
                            Command="{Binding CancelCaptureCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="14,6"
                            FontSize="12"
                            MinHeight="36"
                            Margin="6,0,0,0"
                            IsEnabled="{Binding IsCapturing}"/>
                </Grid>

                <!-- 안내 메시지 (캡처 중) -->
                <TextBlock Text="새 단축키를 입력하세요... (Esc: 취소)"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           Margin="0,0,0,4"
                           Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}"/>

                <!-- ValidationError -->
                <TextBlock Text="{Binding ValidationError}"
                           Foreground="{StaticResource ErrorDot}"
                           FontSize="11"
                           Margin="0,0,0,4"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ValidationError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 저장 버튼 -->
                <Button Content="저장"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Padding="22,8"
                        FontSize="13"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
