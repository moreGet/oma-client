<Window x:Class="OhMyAgent.AiAgent.Client.Views.AgentLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AgentLauncherViewModel, IsDesignTimeCreatable=False}"
        Title="에이전트"
        Width="440" Height="360"
        MinWidth="360" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FocusManager.FocusedElement="{Binding ElementName=FirstTile}">
    <!-- 에이전트 런처 — 사이드바에 아이콘을 평평하게 늘어놓는 대신, 항목 하나가 이 "폴더창"을 열고
         기능을 앱 아이콘처럼 격자로 보여 준다.

         Topmost 와 Owner 를 여기서 대입하지 않는다 — Owner 는 AgentLauncherCoordinator 가 Show 전에 잡는다.
         소유 창은 소유자보다 항상 위에 그려지므로 메인 창이 상단 고정(Topmost)이어도 런처가 그 아래로 숨지 않고,
         Topmost 를 직접 걸면 다른 앱 위에도 떠 버려 화면에 상주하는 방해물이 된다.

         타일을 누르면 창이 먼저 닫히고 나서 기능이 실행된다(AgentLauncherViewModel.Launch).
         그래서 타일은 세션 커맨드가 아니라 Launch* 래퍼만 바인딩한다 — 첨부 대화상자가 런처 뒤로 숨거나
         입력창 포커스 요청이 비활성 창으로 날아가는 것을 막는 순서다. -->

    <Window.InputBindings>
        <!-- Esc 닫기 — 타일·X 버튼과 같은 경로(CloseCommand → CloseRequested → 코디네이터)를 쓴다. -->
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <!-- 다크 메인 창 위에 뜨는 다크 창이라 경계선이 없으면 두 창이 한 덩어리로 보인다. -->
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>   <!-- 타이틀바 -->
                <RowDefinition Height="*"/>    <!-- 타일 격자 -->
                <RowDefinition Height="Auto"/> <!-- 하단 안내 (우측은 크기 조절 그립 자리로 비워 둔다) -->
            </Grid.RowDefinitions>

            <!-- ── 커스텀 타이틀바 (ChatOnlyWindow 미러) ───────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBg}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="{StaticResource RadiusSm}"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,7,0">
                            <TextBlock Text="✦" Foreground="White" FontSize="{StaticResource FontSizeCaption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="에이전트"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 닫기: 코드비하인드 Close() 를 따로 두지 않는다 — 닫는 경로를 타일·Esc 와 하나로 유지한다. -->
                    <Button Content="✕"
                            Command="{Binding CloseCommand}"
                            HorizontalAlignment="Right"
                            Width="30" Height="24"
                            FontSize="{StaticResource FontSizeXSmall}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand"
                            ToolTip="닫기 (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#FB7185"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ── 타일 격자 ────────────────────────────────────────────
                 UniformGrid 라서 창 크기를 바꾸면 셀이 함께 늘어난다(타일 스타일도 고정 크기를 두지 않았다).
                 TabNavigation=Cycle → Tab 이 창 밖으로 나가지 않고 타일 6개를 돈다.
                 DirectionalNavigation=Contained → 방향키가 격자 안에서 기하적으로 이동한다.
                 IsEnabled 를 수동으로 걸지 않는다 — 파일 첨부만 CanExecute(=!IsBusy)로 자동 비활성이고
                 나머지 5개는 항상 실행 가능하다. -->
            <UniformGrid Grid.Row="1" Rows="2" Columns="3" Margin="10,12,10,4"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="Contained">

                <!-- 창이 뜨자마자 키보드로 쓸 수 있어야 런처의 의미가 있다 → 첫 타일이 초기 포커스 대상. -->
                <Button x:Name="FirstTile"
                        Style="{StaticResource LauncherTileButton}"
                        Command="{Binding LaunchLoopCommand}"
                        ToolTip="입력창에 &quot;/loop &quot; 를 넣습니다 — 간격과 프롬프트를 이어서 입력하세요">
                    <StackPanel>
                        <TextBlock Text="&#xE895;" Style="{StaticResource LauncherTileGlyph}"/>
                        <TextBlock Text="반복 실행" Style="{StaticResource LauncherTileLabel}"/>
                        <TextBlock Text="/loop" Style="{StaticResource LauncherTileHint}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource LauncherTileButton}"
                        Command="{Binding LaunchRetryCommand}"
                        ToolTip="직전에 보낸 메시지를 입력창에 되불러 편집합니다">
                    <StackPanel>
                        <TextBlock Text="&#xE72C;" Style="{StaticResource LauncherTileGlyph}"/>
                        <TextBlock Text="마지막 입력" Style="{StaticResource LauncherTileLabel}"/>
                        <TextBlock Text="/retry" Style="{StaticResource LauncherTileHint}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource LauncherTileButton}"
                        Command="{Binding LaunchHelpCommand}"
                        ToolTip="사용 가능한 슬래시 커맨드를 대화에 표시합니다">
                    <StackPanel>
                        <TextBlock Text="&#xE897;" Style="{StaticResource LauncherTileGlyph}"/>
                        <TextBlock Text="도움말" Style="{StaticResource LauncherTileLabel}"/>
                        <TextBlock Text="/help" Style="{StaticResource LauncherTileHint}"/>
                    </StackPanel>
                </Button>

                <!-- 컴포저 "+" 와 의도된 중복이다 — 사이드바를 접으면 이 창을 여는 항목도 함께 사라지므로
                     항상 닿아야 하는 첨부는 컴포저에도 남겨 둔다. 실행 중(IsBusy)에는 비활성이다.
                     대응하는 단일 슬래시 커맨드가 없어 힌트 줄이 없다. -->
                <Button Style="{StaticResource LauncherTileButton}"
                        Command="{Binding LaunchAttachCommand}"
                        ToolTip="파일을 첨부합니다 (실행 중에는 사용할 수 없습니다)">
                    <StackPanel>
                        <TextBlock Text="&#xE723;" Style="{StaticResource LauncherTileGlyph}"/>
                        <TextBlock Text="파일 첨부" Style="{StaticResource LauncherTileLabel}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource LauncherTileButton}"
                        Command="{Binding LaunchNewChatCommand}"
                        ToolTip="현재 대화를 저장하고 새 대화를 시작합니다 — /clear">
                    <StackPanel>
                        <TextBlock Text="&#xE70F;" Style="{StaticResource LauncherTileGlyph}"/>
                        <TextBlock Text="새 대화" Style="{StaticResource LauncherTileLabel}"/>
                        <TextBlock Text="/clear" Style="{StaticResource LauncherTileHint}"/>
                    </StackPanel>
                </Button>

                <!-- 6번째 타일 — 2×3 격자의 마지막 빈 칸을 채운다(레이아웃 변경 없음).
                     앞의 5개와 성격이 다르다: 세션 동작이 아니라 자기 창(작업 관리)을 연다.
                     그래도 같은 Launch* 래퍼를 쓴다 — 런처가 열린 채면 두 소유 창이 겹쳐 목록 창을 덮는다.
                     대응하는 단일 슬래시 커맨드가 없어 힌트 줄이 없다. -->
                <Button Style="{StaticResource LauncherTileButton}"
                        Command="{Binding LaunchTaskManagerCommand}"
                        ToolTip="실행 중인 턴·도구·자식 프로세스를 보고 중지·강제 종료합니다">
                    <StackPanel>
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource LauncherTileGlyph}"/>
                        <TextBlock Text="작업 관리" Style="{StaticResource LauncherTileLabel}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- 항목을 고르면 창이 닫히는 표면이라, 아무 것도 고르지 않고 빠져나가는 방법을 적어 둔다. -->
            <TextBlock Grid.Row="2" Text="항목을 선택하면 창이 닫힙니다 · Esc 로 닫기"
                       Foreground="{StaticResource TextMuted}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FontSizeXSmall}"
                       Margin="16,0,26,10"/>

        </Grid>
    </Border>
</Window>
