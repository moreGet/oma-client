<Window x:Class="OhMyAgent.AiAgent.Client.Views.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TaskManagerViewModel, IsDesignTimeCreatable=False}"
        Title="작업 관리"
        Width="780" Height="600"
        MinWidth="620" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}">
    <!-- 작업 관리(태스크 매니저) — 실행 중인 턴 · 도구 · 자식 프로세스를 보여주고 조작하는 창.
         런처(AgentLauncherWindow)와 같은 커스텀 크롬·같은 코디네이터 관례를 따르고, 두 곳만 다르다:
           1. 목록 창이라 넉넉해야 한다. 780×600 의 근거 — 한 행이 상태 88 + 이름 * + 경과 64 + 동작 124
              (+ 계층 들여쓰기 최대 4단계 × 16 = 64) 를 쓰고, 이름 칸에 명령 원문(최대 120자)이 한 줄로
              읽혀야 하며, 아래에 완료 이력 30개 영역(약 150)까지 함께 들어간다.
              최소 620×420 은 이름 칸이 잘리기 시작하는 하한이다(그 아래로는 표가 읽히지 않는다).
           2. 항목을 조작해도 창을 닫지 않는다(런처와 반대) — 중지가 실제로 먹었는지 지켜보는 창이다.

         Topmost·Owner 를 여기서 대입하지 않는다 — Owner 는 TaskManagerCoordinator 가 Show 전에 잡는다.

         문구 규약(계약): 도구·턴은 "중지"(협조적 취소 요청), 자식 프로세스만 "강제 종료".
         "스레드 종료" 류 표현은 쓰지 않는다 — .NET 에서 관리 스레드 강제 종료는 불가능하고,
         사용자에게 그렇게 했다고 오인시켜서는 안 된다. -->

    <Window.InputBindings>
        <!-- Esc 닫기 — 타이틀바 X 와 같은 경로(CloseCommand → CloseRequested → 코디네이터). -->
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        <!-- 1초 타이머가 이미 돌지만, 사용자가 "지금 다시 봐" 를 표현할 수단이 있어야 한다(하단 버튼과 동일 커맨드). -->
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <!-- 다크 메인 창 위에 뜨는 다크 창이라 경계선이 없으면 두 창이 한 덩어리로 보인다(런처와 동일 판단). -->
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>   <!-- 타이틀바 -->
                <RowDefinition Height="Auto"/> <!-- /loop 행 -->
                <RowDefinition Height="Auto"/> <!-- 중지 지연 안내 -->
                <RowDefinition Height="Auto"/> <!-- 목록 열 머리글 -->
                <RowDefinition Height="*"/>    <!-- 진행 중 목록 -->
                <RowDefinition Height="Auto"/> <!-- 완료 이력 -->
                <RowDefinition Height="Auto"/> <!-- 하단 요약 + 전역 동작 -->
            </Grid.RowDefinitions>

            <!-- ── 커스텀 타이틀바 (ChatOnlyWindow · AgentLauncherWindow 미러) ───────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBg}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="{StaticResource RadiusSm}"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,7,0">
                            <TextBlock Text="✦" Foreground="White" FontSize="{StaticResource FontSizeCaption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="작업 관리"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <!-- 마지막 갱신 시각 — 1초 타이머가 살아 있는지 눈으로 확인할 수 있어야 한다. -->
                        <TextBlock Text="{Binding LastRefreshText}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeMicro}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 닫기: 코드비하인드 Close() 를 따로 두지 않는다 — Esc 와 경로를 하나로 유지한다. -->
                    <Button Content="✕"
                            Command="{Binding CloseCommand}"
                            HorizontalAlignment="Right"
                            Width="30" Height="24"
                            FontSize="{StaticResource FontSizeXSmall}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand"
                            ToolTip="닫기 (Esc) — 진행 중인 작업에는 손대지 않습니다">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#FB7185"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ── /loop 행 ────────────────────────────────────────────────
                 등기소에 루프를 복제하지 않는다(진실 원천이 둘이 되면 반드시 어긋난다) —
                 이 행만 LoopController 를 직접 읽고, 문구는 LoopStatusFormatter 를 재사용한다.
                 미실행이면 문구가 빈 문자열이라 행 자체가 사라진다. -->
            <Border Grid.Row="1" Margin="12,10,12,0" Padding="10,7"
                    Background="{StaticResource Surface2Bg}"
                    BorderBrush="{StaticResource AccentSoftBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Visibility="{Binding LoopStatusText, Converter={StaticResource StringToVisibility}}">
                <Grid>
                    <TextBlock Text="{Binding LoopStatusText}"
                               Foreground="{StaticResource AccentSoftBrush}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeXSmall}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding LoopStatusText}"
                               Margin="0,0,90,0"/>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource TaskRowActionButton}"
                            Command="{Binding StopLoopCommand}"
                            ToolTip="반복 실행을 중지합니다 — 지금 돌고 있는 턴은 스스로 접힐 때까지 남아 있을 수 있습니다">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource FontSizeMicro}" VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="반복 실행 중지" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ── 중지 지연 안내 ──────────────────────────────────────────
                 협조적 중지가 통하지 않는 항목이 있을 때만 뜬다. 이때 사용자가 실제로 손쓸 수 있는
                 유일한 수단이 자식 프로세스 강제 종료라는 사실을 여기서 알려 준다. -->
            <Border Grid.Row="2" Margin="12,10,12,0" Padding="10,7"
                    Background="{StaticResource Surface2Bg}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Visibility="{Binding HasCancelStalled, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="{StaticResource FontSizeXSmall}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Foreground="{StaticResource WarningBrush}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeXSmall}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="중지를 요청했지만 끝나지 않은 작업이 있습니다 — 그 아래 자식 프로세스를 강제 종료하면 풀릴 수 있습니다."/>
                </StackPanel>
            </Border>

            <!-- ── 목록 열 머리글 (아래 행 템플릿과 열 폭이 1:1) ─────────────────
                 좌우 여백 25 = 목록 Grid 12 + Border 테두리 1 + ScrollViewer Padding 6 + 행 Padding 6.
                 이 합이 맞지 않으면 머리글과 열 경계가 어긋나 표로 읽히지 않는다(세로 스크롤바가 나타나면
                 우측은 그만큼 더 밀리지만, 열 폭을 정하는 좌측 기준은 이 값으로 일치한다). -->
            <Grid Grid.Row="3" Margin="25,12,25,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="124"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="상태"           Style="{StaticResource TaskColumnHeader}"/>
                <TextBlock Grid.Column="1" Text="이름 · 인자"     Style="{StaticResource TaskColumnHeader}"/>
                <TextBlock Grid.Column="2" Text="경과"           Style="{StaticResource TaskColumnHeader}"
                           TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="동작"           Style="{StaticResource TaskColumnHeader}"
                           TextAlignment="Right"/>
            </Grid>

            <!-- ── 진행 중 목록 ────────────────────────────────────────────
                 트리 컨트롤을 쓰지 않는다 — 스냅샷이 깊이 우선 정렬 + Depth 계산까지 끝내 오므로
                 다시 조립하면 진실 원천이 둘이 된다. 들여쓰기는 이름 칸의 Margin(Depth×16)뿐이다.
                 1초마다 컬렉션을 통째로 갈지 않고 Id 기준 병합 갱신하므로 스크롤이 튀지 않는다(VM 참조). -->
            <Grid Grid.Row="4" Margin="12,0,12,0">
                <Border Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="6,4">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ActivityItemViewModel}">
                                    <Border Margin="0,1" Padding="6,5"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"  Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <!-- 강조는 Core 가 계산한 Health 하나만 따른다(우선순위도 그쪽이 정본):
                                                         취소 상태가 소요 시간보다 앞선다 — 중지를 눌렀는데 "오래 걸림"만
                                                         보이면 사용자는 자기 클릭이 접수됐는지 알 수 없다. -->
                                                    <DataTrigger Binding="{Binding Health}" Value="LongRunning">
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Health}" Value="CancelPending">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Health}" Value="CancelStalled">
                                                        <Setter Property="BorderBrush" Value="{StaticResource ErrorDot}"/>
                                                        <Setter Property="Background"  Value="{StaticResource Surface2Bg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="124"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 상태: 점 색으로 Health, 글로 State(실행 중 / 중지 요청) -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource ConnectedDot}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Health}" Value="LongRunning">
                                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Health}" Value="CancelPending">
                                                                    <Setter Property="Fill" Value="{StaticResource AccentSoftBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Health}" Value="CancelStalled">
                                                                    <Setter Property="Fill" Value="{StaticResource ErrorDot}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StateText}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="{StaticResource FontSizeXSmall}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 이름 · 인자 — 계층 들여쓰기는 이 칸에만 준다(다른 열이 어긋나면 표로 읽히지 않는다). -->
                                            <StackPanel Grid.Column="1"
                                                        Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- 종류 배지: 글리프 대신 짧은 한국어. 턴/도구/프로세스의 의미 차이가
                                                         아이콘으로는 전달되지 않고, 이 창에서는 그 차이가 곧 조작 가능 범위다. -->
                                                    <Border Background="{StaticResource Surface3Bg}"
                                                            CornerRadius="{StaticResource RadiusXs}"
                                                            Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindText}"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="{StaticResource FontSizeMicro}"/>
                                                    </Border>
                                                    <!-- 도구 위험도 점(기존 ToolRiskToBrush 재사용) -->
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Fill="{Binding Risk, Converter={StaticResource ToolRiskToBrush}}"
                                                             ToolTip="{Binding Risk, Converter={StaticResource ToolRiskToText}}"
                                                             Visibility="{Binding HasRisk, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding IterationText}"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="{StaticResource FontSizeMicro}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                                               Visibility="{Binding HasIteration, Converter={StaticResource BoolToVisibility}}"/>
                                                    <!-- 부모 작업이 이미 끝난 프로세스 = "관련 프로세스 정리" 대상 -->
                                                    <Border Background="{StaticResource Surface3Bg}"
                                                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                                            CornerRadius="{StaticResource RadiusXs}"
                                                            Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            ToolTip="이 프로세스를 띄운 작업은 이미 끝났습니다 — 하단 &quot;관련 프로세스 정리&quot; 대상입니다"
                                                            Visibility="{Binding IsOrphanCandidate, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="소유 작업 종료됨"
                                                                   Foreground="{StaticResource WarningBrush}"
                                                                   FontFamily="{StaticResource AppFont}"
                                                                   FontSize="{StaticResource FontSizeMicro}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 인자 요약: 병렬 도구 8줄이 이름만 같을 때 유일한 식별 수단이다. -->
                                                <TextBlock Text="{Binding Detail}"
                                                           ToolTip="{Binding Detail}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="{StaticResource FontSizeMicro}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"/>

                                                <TextBlock Text="{Binding NoteText}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="{StaticResource FontSizeMicro}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Health}" Value="CancelStalled">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorDot}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- 경과 — LoopIntervalParser.Format 표기를 그대로 쓴다(새 포매터 없음). -->
                                            <TextBlock Grid.Column="2" Text="{Binding ElapsedText}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="{StaticResource FontSizeXSmall}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Top"/>

                                            <!-- 동작 — 어떤 버튼을 "둘지"는 종류가, "활성인지"는 Core 의 CanCancel/CanKill 이 정한다.
                                                 프로세스 행에는 "중지"를 두지 않는다(RequestCancel 이 항상 false 다). -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button Style="{StaticResource TaskRowActionButton}"
                                                        Content="중지"
                                                        IsEnabled="{Binding CanCancel}"
                                                        Visibility="{Binding SupportsCancel, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="중지를 요청합니다(협조적) — 눌러도 즉시 사라지지 않을 수 있고, 이미 시작된 변경은 되돌아가지 않습니다"/>
                                                <Button Style="{StaticResource TaskRowDangerButton}"
                                                        Content="강제 종료"
                                                        IsEnabled="{Binding CanKill}"
                                                        Visibility="{Binding IsProcess, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.KillItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="이 자식 프로세스를 OS 수준에서 종료합니다. 신원(PID·시작 시각·이름)을 다시 확인해 재사용된 PID 는 건드리지 않습니다"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 빈 표를 그대로 보여 주면 고장처럼 읽힌다 — 평소 상태를 말로 적어 둔다. -->
                <TextBlock Text="지금 실행 중인 작업이 없습니다."
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeXSmall}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>

            <!-- ── 완료 이력 ───────────────────────────────────────────────
                 진행 중만 보이면 대부분의 시간에 빈 목록이고, 무엇보다 사용자가 누른 중지가 실제로
                 먹었는지 확인할 방법이 사라진다(누르면 목록에서 사라질 뿐이다). 고정 30개라 무한 증가는 없다. -->
            <Grid Grid.Row="5" Margin="12,10,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="최근 완료 (최대 30개 · 최신 위)"
                           Style="{StaticResource TaskColumnHeader}" Margin="8,0,0,4"/>

                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}">
                    <Grid>
                        <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="6,4">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ActivityHistoryItemViewModel}">
                                        <Grid Margin="6,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding FinishedAtText}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       VerticalAlignment="Center"/>

                                            <!-- 최종 상태 — "중지됨" 이 여기 보이면 사용자가 누른 중지가 실제로 먹은 것이다. -->
                                            <TextBlock Grid.Column="1" Text="{Binding StateText}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FinalState}" Value="Canceled">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FinalState}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorDot}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding KindText}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="{StaticResource FontSizeMicro}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="{StaticResource FontSizeMicro}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- 비고: "PID 재사용 — 종료하지 않음" 같은, 건드리지 않은 이유가 여기 남는다. -->
                                                <TextBlock Text="{Binding Note}"
                                                           ToolTip="{Binding Note}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="{StaticResource FontSizeMicro}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="아직 끝난 작업이 없습니다."
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeMicro}"
                                   Margin="12,10"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasRecent, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── 하단: 요약 · 마지막 조작 결과 · 전역 동작 ─────────────────
                 우측 26px 는 크기 조절 그립 자리로 비워 둔다(CanResizeWithGrip). -->
            <Grid Grid.Row="6" Margin="16,10,26,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SummaryText}"
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- 마지막 조작 결과. 특히 강제 종료가 "안 죽였다"(PID 재사용·확인 불가)로 끝난 경우를
                     사용자에게 반드시 알려야 한다 — 죽은 줄 알고 넘어가면 프로세스가 방치된다. -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding ActionResultText}"
                           ToolTip="{Binding ActionResultText}"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding ActionResultText, Converter={StaticResource StringToVisibility}}"/>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TaskFooterButton}"
                            Command="{Binding CancelAllCommand}"
                            ToolTip="진행 중인 모든 턴·도구에 중지를 요청합니다. 자식 프로세스는 함께 종료되지 않습니다(각 행의 &quot;강제 종료&quot;가 별개 조작입니다)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource FontSizeXSmall}" VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="전역 중지" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TaskFooterButton}"
                            Command="{Binding SweepOrphansCommand}"
                            ToolTip="이 앱이 띄운 프로세스 중 소유 작업이 이미 끝난 것만 정리합니다. 시스템 프로세스 목록은 훑지 않고, PID 가 재사용된 항목은 건드리지 않습니다">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource FontSizeXSmall}" VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="관련 프로세스 정리" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TaskFooterButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="지금 다시 조회합니다 (F5) — 창이 열려 있는 동안에는 1초마다 자동 갱신됩니다">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{StaticResource FontSizeXSmall}" VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBlock Text="새로고침" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
