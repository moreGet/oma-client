<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>OhMyAgent.AiAgent.Client</RootNamespace>
        <AssemblyName>OhMyAgent.AiAgent.Client</AssemblyName>
        <Version>1.3.0</Version>

        <!-- exe 아이콘. WPF 창은 Window.Icon 미지정 시 이 아이콘을 자동 상속하므로
             트레이(App.CreateAppIcon)·창·바로가기·인스톨러가 모두 같은 도안이 된다.
             생성: installer\New-AppIcon.ps1 (트레이와 동일한 도안을 다중 해상도로 렌더) -->
        <ApplicationIcon>Resources\app.ico</ApplicationIcon>

        <!-- 인스톨러·탐색기 속성창에 노출되는 메타데이터. -->
        <Company>KT</Company>
        <Product>OhMyAgent</Product>
        <AssemblyTitle>OhMyAgent AI 에이전트</AssemblyTitle>
        <Description>사내 AI 서버와 연동하는 데스크톱 AI 에이전트 클라이언트</Description>
        <Copyright>Copyright © KT</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <!-- GlobMatcher/PathIgnore 등 internal 헬퍼를 테스트에서 직접 검증하기 위함. -->
        <InternalsVisibleTo Include="OhMyAgent.AiAgent.Client.Tests" />
    </ItemGroup>

    <!-- git 짧은 해시를 SourceRevisionId 로 주입 → SDK가 InformationalVersion 에 "+<hash>" 부착.
         해시를 못 구해도(폐쇄망/비-git) ContinueOnError 로 빌드 비파괴. -->
    <Target Name="SetGitHash" BeforeTargets="GetAssemblyVersion;CoreCompile" Condition="'$(SourceRevisionId)' == ''">
        <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_GitHash" />
        </Exec>
        <PropertyGroup>
            <SourceRevisionId Condition="'$(_GitHash)' != ''">$(_GitHash)</SourceRevisionId>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <!-- MVVM 소스 생성기 -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <!-- ClosedXML/DocumentFormat.OpenXml/PdfPig 은 문서·스프레드시트 도구와 함께 Core 로 이전.
             Core ProjectReference 로 전이 획득하므로 Client 직접 참조를 제거한다. -->
        <!-- JSON 직렬화는 BCL System.Text.Json 사용 (별도 패키지 불필요) -->
        <!-- System.Drawing 은 UseWindowsForms=true 가 제공하므로 패키지 참조 제거(NU1510) -->
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\OhMyAgent.AiAgent.Core\OhMyAgent.AiAgent.Core.csproj" />
    </ItemGroup>

</Project>
