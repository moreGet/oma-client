<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tvm="clr-namespace:OhMyAgent.AiAgent.Client.ViewModels.Transcript"
                    xmlns:views="clr-namespace:OhMyAgent.AiAgent.Client.Views"
                    xmlns:md="clr-namespace:OhMyAgent.AiAgent.Client.Views.Markdown"
                    xmlns:diff="clr-namespace:OhMyAgent.AiAgent.Client.Services.Diff;assembly=OhMyAgent.AiAgent.Core">

    <!-- ══ 사용자 메시지 버블 (accent 그라데이션) ════════════════════════ -->
    <DataTemplate x:Key="UserTurnTemplate" DataType="{x:Type tvm:UserTurnViewModel}">
        <Grid Margin="84,6,14,6">
            <Border Background="{StaticResource UserBubbleGradient}"
                    CornerRadius="16,16,4,16"
                    Padding="16,11"
                    HorizontalAlignment="Right"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl},
                                       Converter={StaticResource Multiply}, ConverterParameter=0.82}"
                    Effect="{StaticResource SoftShadow}">
                <TextBlock Text="{Binding Text}"
                           Foreground="White"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           TextWrapping="Wrap"
                           LineHeight="23"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ══ 어시스턴트 스트리밍 텍스트 (부드러운 서피스 카드) ═════════════ -->
    <DataTemplate x:Key="AssistantTurnTemplate" DataType="{x:Type tvm:AssistantTurnViewModel}">
        <Grid Margin="14,6,84,6">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,5">
                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusSm}"
                            Background="{StaticResource AccentSubtleBrush}"
                            Margin="0,0,7,0">
                        <TextBlock Text="🤖" FontSize="{StaticResource FontSizeXSmall}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AI Agent"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeXSmall}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- 복사: 렌더된 응답은 통째로 선택이 안 되므로 원문 복사 버튼을 제공. 스트리밍 끝나면 표시. -->
                    <Button Command="{Binding CopyCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,0"
                            Margin="8,0,0,0"
                            ToolTip="응답 복사"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsStreaming, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="⧉ 복사"
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeCaption}"/>
                    </Button>
                </StackPanel>
                <Border Background="{StaticResource AgentBubble}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4,16,16,16"
                        Padding="16,11"
                        HorizontalAlignment="Left"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl},
                                           Converter={StaticResource Multiply}, ConverterParameter=0.82}"
                        Effect="{StaticResource SoftShadow}">
                    <!-- 마크다운 렌더: 코드 펜스·인라인 코드·굵게/기울임·헤더·목록을 서식화한다.
                         md:Markdown.Source 가 Text 변경 시마다 블록 요소를 다시 만든다(스트리밍 중 라이브 갱신).
                         커서는 본문 아래에 두어 스트리밍 진행을 표시한다. -->
                    <StackPanel>
                        <StackPanel md:Markdown.Source="{Binding Text}"/>
                        <TextBlock Text="▋"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                   Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1" To="0"
                                                        Duration="0:0:0.5"
                                                        AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ══ 시스템 안내 라인 ════════════════════════════════════════════ -->
    <DataTemplate x:Key="SystemNoticeTemplate" DataType="{x:Type tvm:SystemNoticeViewModel}">
        <Border Margin="14,5"
                Padding="14,7"
                HorizontalAlignment="Center"
                CornerRadius="{StaticResource RadiusLg}"
                Background="{StaticResource Surface2Bg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <TextBlock Text="{Binding Text}"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FontSizeSmall}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </Border>
    </DataTemplate>

    <!-- ══ 도구 호출 카드 (접이식 · 라운드 + 섀도) ═════════════════════ -->
    <DataTemplate x:Key="ToolCallTemplate" DataType="{x:Type tvm:ToolCallViewModel}">
        <Border Margin="14,6,84,6"
                Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius2Xl}"
                Effect="{StaticResource SoftShadow}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ErrorDot}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- 헤더: 확장 토글 -->
                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              Cursor="Hand"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              Padding="14,11">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="HdrRoot"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="14,14,0,0">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HdrRoot" Property="Background" Value="{StaticResource Surface2Bg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 확장 표시 화살표 -->
                        <TextBlock Grid.Column="0"
                                   Text="▸"
                                   FontSize="{StaticResource FontSizeXSmall}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{StaticResource TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="▾"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 위험도 칩 -->
                        <Border Grid.Column="1"
                                Style="{StaticResource Chip}"
                                Margin="0,0,10,0"
                                Background="{Binding Risk, Converter={StaticResource ToolRiskToBrush}}">
                            <TextBlock Text="{Binding Risk, Converter={StaticResource ToolRiskToText}}"
                                       Foreground="White"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <!-- 도구 이름 -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ToolName}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource MonoFont}"
                                   VerticalAlignment="Center"/>

                        <!-- 상태 칩 -->
                        <Border Grid.Column="3"
                                Style="{StaticResource Chip}"
                                Margin="8,0,0,0"
                                Background="{StaticResource AccentSubtleBrush}">
                            <TextBlock Text="{Binding Status, Converter={StaticResource ToolCallStatusToText}}"
                                       Foreground="{Binding Status, Converter={StaticResource ToolCallStatusToBrush}}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="{StaticResource FontSizeXSmall}"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </ToggleButton>

                <!-- 본문: 인자 + 결과 (확장 시) -->
                <StackPanel Margin="14,0,14,12"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <!-- 인자 -->
                    <TextBlock Text="인자"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Margin="0,2,0,4"/>
                    <Border Background="{StaticResource WindowBg}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="10,8"
                            Visibility="{Binding ArgsPreview, Converter={StaticResource StringToVisibility}}">
                        <TextBox Text="{Binding ArgsPreview, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextSecondary}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="{StaticResource FontSizeSmall}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="200"/>
                    </Border>

                    <!-- 결과 -->
                    <TextBlock Text="결과"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Margin="0,10,0,4"
                               Visibility="{Binding ResultText, Converter={StaticResource StringToVisibility}}"/>
                    <Border Background="{StaticResource WindowBg}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="10,8"
                            Visibility="{Binding ResultText, Converter={StaticResource StringToVisibility}}">
                        <TextBox Text="{Binding ResultText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="{StaticResource FontSizeSmall}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="280">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorDot}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ══ 확장 사고 블록 (접이식 · 흐릿 · 최종 답변과 구분) ═════════════ -->
    <DataTemplate x:Key="ThinkingTemplate" DataType="{x:Type tvm:ThinkingViewModel}">
        <Border Margin="14,4,84,4"
                Padding="12,8"
                CornerRadius="{StaticResource RadiusLg}"
                Background="{StaticResource Surface2Bg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <!-- 헤더: 클릭하면 접힘/펼침 토글 -->
                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              Cursor="Hand"
                              HorizontalAlignment="Left"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💭" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,6,0"/>
                                <TextBlock Text="사고 과정"
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <!-- 스트리밍 중 표시 -->
                                <TextBlock Text=" · 생각 중…"
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- 본문: 흐릿한 회색, 접힘 상태면 숨김 -->
                <TextBlock Text="{Binding Text}"
                           Margin="2,6,0,0"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ══ 셀렉터 ══════════════════════════════════════════════════════ -->
    <views:TranscriptItemTemplateSelector x:Key="TranscriptSelector"
        UserTemplate="{StaticResource UserTurnTemplate}"
        AssistantTemplate="{StaticResource AssistantTurnTemplate}"
        SystemTemplate="{StaticResource SystemNoticeTemplate}"
        ToolCallTemplate="{StaticResource ToolCallTemplate}"
        ThinkingTemplate="{StaticResource ThinkingTemplate}"/>

    <!-- ══ 인라인 승인 카드 (PendingApproval) ══════════════════════════ -->
    <!-- DataContext = ApprovalRequestViewModel -->
    <DataTemplate x:Key="ApprovalCardTemplate">
        <Border Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1.5"
                CornerRadius="{StaticResource Radius2Xl}"
                Padding="18,14"
                Margin="14,8"
                Effect="{StaticResource CardShadow}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="⏳ 도구 실행 승인 요청"
                               Foreground="{StaticResource WarningBrush}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Chip}"
                            Margin="10,0,0,0"
                            Background="{Binding Risk, Converter={StaticResource ToolRiskToBrush}}">
                        <TextBlock Text="{Binding Risk, Converter={StaticResource ToolRiskToText}}"
                                   Foreground="White"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding ToolName}"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource MonoFont}"
                           Margin="0,0,0,8"/>

                <!-- edit_file: 실제 변경을 diff 로. 사용자가 무엇이 지워지고 추가되는지 보고 승인한다. -->
                <Border Background="{StaticResource WindowBg}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="0"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding DiffPath}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Padding="10,6,10,4"/>
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Diff}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type diff:DiffLine}">
                                        <Border Padding="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                            <Setter Property="Background" Value="{StaticResource DiffAddBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                            <Setter Property="Background" Value="{StaticResource DiffRemoveBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="{StaticResource MonoFont}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                        <Setter Property="Text" Value="{Binding Text}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                                <Setter Property="Foreground" Value="{StaticResource DiffAddText}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                                <Setter Property="Foreground" Value="{StaticResource DiffRemoveText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 그 외 도구: 생 JSON 인자. diff 가 있으면 숨긴다(중복). -->
                <Border Background="{StaticResource WindowBg}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="10,8"
                        Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- ArgsPreview 가 있고 diff 는 없을 때만 표시 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasDiff}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility"
                                            Value="{Binding ArgsPreview, Converter={StaticResource StringToVisibility}}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox Text="{Binding ArgsPreview, Mode=OneWay}"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource TextSecondary}"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="{StaticResource FontSizeSmall}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="160"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="거부"
                            Command="{Binding DenyCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="18,7"
                            FontSize="{StaticResource FontSizeSmall}"
                            Margin="0,0,8,0"/>
                    <Button Content="항상 허용"
                            Command="{Binding AlwaysAllowCommand}"
                            Style="{StaticResource OutlineButton}"
                            Padding="18,7"
                            FontSize="{StaticResource FontSizeSmall}"
                            Margin="0,0,8,0"/>
                    <Button Content="허용"
                            Command="{Binding AllowCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="22,7"
                            FontSize="{StaticResource FontSizeSmall}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
