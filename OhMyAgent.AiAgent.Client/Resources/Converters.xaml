<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:OhMyAgent.AiAgent.Client.Views">

    <views:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <views:InverseBoolConverter             x:Key="InverseBool"/>
    <views:BoolToStatusBrushConverter       x:Key="BoolToStatusBrush"/>

    <!-- ── Agent transcript / approval ─────────────────────────────── -->
    <views:NullToVisibilityConverter        x:Key="NullToVisibility"/>
    <views:StringToVisibilityConverter      x:Key="StringToVisibility"/>
    <views:CountToVisibilityConverter       x:Key="CountToVisibility"/>
    <views:EmptyCountToVisibilityConverter  x:Key="EmptyCountToVisibility"/>
    <views:ToolRiskToBrushConverter         x:Key="ToolRiskToBrush"/>
    <views:ToolRiskToTextConverter          x:Key="ToolRiskToText"/>
    <views:ToolCallStatusToBrushConverter   x:Key="ToolCallStatusToBrush"/>
    <views:ToolCallStatusToTextConverter    x:Key="ToolCallStatusToText"/>
    <views:MultiplyConverter                x:Key="Multiply"/>
    <views:BoolToGridLengthConverter        x:Key="BoolToGridLength"/>

    <!-- ── Chat (사람↔사람 메신저) · 설계서 §1 ─────────────────────── -->
    <views:UnixSecondsToLocalTimeConverter     x:Key="UnixSecondsToLocalTime"/>
    <views:UnreadCountToBadgeVisibilityConverter x:Key="UnreadCountToBadgeVisibility"/>
    <views:ChatConnectionStateToBrushConverter x:Key="ChatConnectionStateToBrush"/>
    <views:IsMineToAlignmentConverter          x:Key="IsMineToAlignment"/>
    <views:IsMineToBubbleBrushConverter        x:Key="IsMineToBubbleBrush"/>
    <views:InitialConverter                    x:Key="Initial"/>

</ResourceDictionary>
