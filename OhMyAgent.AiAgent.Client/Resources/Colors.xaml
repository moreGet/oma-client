<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 배경 팔레트 ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WindowBg"      Color="#0D1117"/>
    <SolidColorBrush x:Key="SurfaceBg"     Color="#161B22"/>
    <SolidColorBrush x:Key="Surface2Bg"    Color="#21262D"/>
    <SolidColorBrush x:Key="InputBg"       Color="#0D1117"/>

    <!-- ── 메시지 버블 ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="UserBubble"    Color="#1F6FEB"/>
    <SolidColorBrush x:Key="AgentBubble"   Color="#21262D"/>

    <!-- ── 텍스트 ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#C9D1D9"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B949E"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#484F58"/>

    <!-- ── 액센트 / 상태 ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AccentBrush"   Color="#388BFD"/>
    <SolidColorBrush x:Key="ConnectedDot"  Color="#3FB950"/>
    <SolidColorBrush x:Key="ErrorDot"      Color="#F85149"/>
    <SolidColorBrush x:Key="WarningBrush"  Color="#D29922"/>

    <!-- ── 테두리 ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderBrush"   Color="#30363D"/>
    <SolidColorBrush x:Key="BorderLight"   Color="#484F58"/>

    <!-- ── 색상 값 (트리거용) ─────────────────────────────────────── -->
    <Color x:Key="AccentColor"    >#388BFD</Color>
    <Color x:Key="ConnectedColor" >#3FB950</Color>
    <Color x:Key="ErrorColor"     >#F85149</Color>

</ResourceDictionary>
