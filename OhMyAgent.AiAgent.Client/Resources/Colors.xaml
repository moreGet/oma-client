<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════
         Fluent Dark · Violet/Indigo accent palette
         Surface layering: WindowBg < SurfaceBg < Surface2Bg
         ══════════════════════════════════════════════════════════════ -->

    <!-- ── 배경 / 서피스 계층 ─────────────────────────────────────── -->
    <SolidColorBrush x:Key="WindowBg"      Color="#0B0D14"/>
    <SolidColorBrush x:Key="SurfaceBg"     Color="#13161F"/>
    <SolidColorBrush x:Key="Surface2Bg"    Color="#1B1F2A"/>
    <SolidColorBrush x:Key="Surface3Bg"    Color="#232838"/>
    <SolidColorBrush x:Key="InputBg"       Color="#10131B"/>

    <!-- ── 메시지 버블 ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="UserBubble"    Color="#7C5CFF"/>
    <SolidColorBrush x:Key="AgentBubble"   Color="#1B1F2A"/>

    <!-- 사용자 버블 그라데이션 (violet → indigo) -->
    <LinearGradientBrush x:Key="UserBubbleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8268FF" Offset="0"/>
        <GradientStop Color="#6A53F0" Offset="1"/>
    </LinearGradientBrush>

    <!-- 액센트 그라데이션 (버튼/강조 표면) -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8268FF" Offset="0"/>
        <GradientStop Color="#7C5CFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── 텍스트 ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#E6E8F0"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9CA3B4"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#5B6273"/>

    <!-- ── 액센트 (violet/indigo) ─────────────────────────────────── -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#7C5CFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#8F73FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6A47E6"/>
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="#6366F1"/>
    <!-- 포커스 글로우용 반투명 액센트 -->
    <SolidColorBrush x:Key="AccentGlowBrush"    Color="#807C5CFF"/>
    <SolidColorBrush x:Key="AccentSubtleBrush"  Color="#1F2540"/>

    <!-- ── 상태색 (현대적 톤) ─────────────────────────────────────── -->
    <SolidColorBrush x:Key="ConnectedDot"  Color="#34D399"/>
    <SolidColorBrush x:Key="ErrorDot"      Color="#FB7185"/>
    <SolidColorBrush x:Key="WarningBrush"  Color="#FBBF24"/>

    <!-- ── 무결성 상태색 (정상/변조/손상/누락/추가) ──────────────── -->
    <SolidColorBrush x:Key="IntegrityOkBrush"         Color="#34D399"/>  <!-- 녹색 · 정상 -->
    <SolidColorBrush x:Key="IntegrityModifiedBrush"   Color="#FBBF24"/>  <!-- 주황 · 변조 -->
    <SolidColorBrush x:Key="IntegrityCorruptedBrush"  Color="#FB7185"/>  <!-- 적색 · 손상 -->
    <SolidColorBrush x:Key="IntegrityMissingBrush"    Color="#9CA3B4"/>  <!-- 회색 · 누락 -->
    <SolidColorBrush x:Key="IntegrityUnexpectedBrush" Color="#60A5FA"/>  <!-- 청색 · 추가 -->

    <!-- ── 테두리 ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderBrush"   Color="#262B38"/>
    <SolidColorBrush x:Key="BorderLight"   Color="#363C4C"/>

    <!-- ── 색상 값 (트리거 / 애니메이션용) ───────────────────────── -->
    <Color x:Key="AccentColor"        >#7C5CFF</Color>
    <Color x:Key="AccentHoverColor"   >#8F73FF</Color>
    <Color x:Key="AccentPressedColor" >#6A47E6</Color>
    <Color x:Key="ConnectedColor"     >#34D399</Color>
    <Color x:Key="ErrorColor"         >#FB7185</Color>

    <!-- ══════════════════════════════════════════════════════════════
         Chat(사람↔사람 메신저) 전용 파랑 팔레트 · presentation_service.html :root
         전역 보라 accent 와 분리된 신규 키만 사용(기존 키 값 불변).
         ══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ChatAccentBrush"     Color="#388BFD"/>  <!-- 채팅 파랑(주) -->
    <SolidColorBrush x:Key="ChatAccent2Brush"    Color="#6EA8FF"/>  <!-- 멘션·읽음·보낸이·타이핑 -->
    <SolidColorBrush x:Key="ChatOnlineBrush"     Color="#2EA043"/>  <!-- 온라인 점(초록) -->
    <SolidColorBrush x:Key="ChatOnlineGlowBrush" Color="#4D2EA043"/><!-- 온라인 점 글로우(rgba .30) -->
    <SolidColorBrush x:Key="ChatSurfaceBrush"    Color="#151C28"/>  <!-- 방 카드 배경 -->
    <SolidColorBrush x:Key="ChatSurface2Brush"   Color="#1B2433"/>  <!-- them 버블 배경 -->
    <SolidColorBrush x:Key="ChatLineBrush"       Color="#26303F"/>  <!-- 카드/them 버블 테두리 -->
    <SolidColorBrush x:Key="ChatMeBubbleBrush"   Color="#29388BFD"/><!-- me 버블 배경(rgba .16) -->
    <SolidColorBrush x:Key="ChatMeBorderBrush"   Color="#59388BFD"/><!-- me 버블 테두리(rgba .35) -->
    <SolidColorBrush x:Key="ChatMutedBrush"      Color="#93A1B5"/>  <!-- presence/부제 -->
    <SolidColorBrush x:Key="ChatDimBrush"        Color="#5D6B7E"/>  <!-- 메타(시각) -->

    <!-- 아바타 그라디언트 (CSS 135° : accent → violet) -->
    <LinearGradientBrush x:Key="ChatAvatarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#388BFD" Offset="0"/>
        <GradientStop Color="#A371F7" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
