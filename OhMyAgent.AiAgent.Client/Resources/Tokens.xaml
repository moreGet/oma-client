<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ══════════════════════════════════════════════════════════════════
         DESIGN TOKENS — 디자이너용 단일 조정 지점
         색상 토큰은 Colors.xaml, 폰트 패밀리/그림자는 Styles.xaml 상단 참조.
         이 파일은 타이포 크기 · 모서리 반경 · 간격 스케일을 담는다.
         값은 현재 디자인과 1:1(시각 변화 없음). 값만 바꾸면 전역 반영.
         로드 순서: Colors → Tokens → Styles (App.xaml). Styles도 이 토큰을 참조 가능.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── 타이포그래피 스케일 (FontSize, 단위 DIP ≈ CSS px) ────────────────
         CSS 대응: font-size 토큰.
         Micro 9 · Caption 10 · XSmall 11 · Small 12 · Body 13 · BodyLarge 14
         Subtitle 15 · Title 18 · Heading 26 · HeadingLarge 28 · Display 36 -->
    <sys:Double x:Key="FontSizeMicro">9</sys:Double>
    <sys:Double x:Key="FontSizeCaption">10</sys:Double>
    <sys:Double x:Key="FontSizeXSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">15</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeHeading">26</sys:Double>
    <sys:Double x:Key="FontSizeHeadingLarge">28</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">36</sys:Double>

    <!-- ── 모서리 반경 스케일 (CornerRadius) ───────────────────────────────
         CSS 대응: border-radius 토큰. Pill은 토글/칩의 완전 둥근 모서리. -->
    <CornerRadius x:Key="RadiusTiny">2</CornerRadius>
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="Radius2Xl">14</CornerRadius>
    <CornerRadius x:Key="Radius3Xl">18</CornerRadius>
    <CornerRadius x:Key="RadiusPill">11</CornerRadius>

    <!-- ── 간격 스케일 (Double) · Margin/Padding 수치 토큰 ──────────────────
         CSS 대응: spacing 토큰. 4px 기반 리듬 + 실사용 보조값(6/10/14/18/22). -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space1_5">6</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space2_5">10</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space3_5">14</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space4_5">18</sys:Double>
    <sys:Double x:Key="Space5">22</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>

    <!-- ── 간격 (Thickness) — 자주 쓰는 균일 여백 프리셋 ───────────────────
         비균일 여백(예: "24,0,24,18")은 컴포넌트 고유라 인라인 유지. -->
    <Thickness x:Key="SpaceXsAll">4</Thickness>
    <Thickness x:Key="SpaceSmAll">8</Thickness>
    <Thickness x:Key="SpaceMdAll">12</Thickness>
    <Thickness x:Key="SpaceLgAll">16</Thickness>

</ResourceDictionary>
